+// küçük yardımcılar
+const roll = (e, t, n, gap0, gap1, v0, v1, rate = 1) => {
+	let tt = t;
+	for (let i = 0; i < n; i++) {
+		const k = i / Math.max(1, n - 1);
+		e.hit('tek', tt, v0 + (v1 - v0) * k, rate * (0.95 + e.r() * 0.1), (i % 2 ? 0.2 : -0.2));
+		tt += gap0 + (gap1 - gap0) * k;
+	}
+	return tt;
+};
