---
// AKSOY logosu: solda gerçek 3D modellerden üretilmiş, kendi ekseni etrafında dönen takımlar
// (CNMG uç → 45° freze çakısı → ER pens, sırayla), sağda iri AKSOY yazısı.
// Dönüş önceden üretilmiş kare şeritleriyle yapılır (WebGL yok, cihazı yormaz).
interface Props { sub?: boolean; class?: string }
const { sub = true, class: cls } = Astro.props;
const spins = [
  { src: '/img/logo/insert.webp', n: 30, d: 1.5 },
  { src: '/img/logo/mill.webp', n: 24, d: 1.25 },
  { src: '/img/logo/collet.webp', n: 16, d: 1.1 },
];
---
<a href="/" class:list={['logo', cls]} aria-label="Aksoy Kesici Takımlar — ana sayfa">
  <span class="logo__3d" aria-hidden="true" data-logo3d>
    {spins.map((s, i) => (
      <i class:list={['lm', { 'is-on': i === 0 }]} style={`--n:${s.n};--d:${s.d}s;${i === 0 ? `background-image:url(${s.src})` : ''}`} data-bg={s.src}></i>
    ))}
  </span>
  <svg class="logo__type" viewBox="0 0 104 40" aria-hidden="true" focusable="false">
    <text class="logo__w" x="0" y={sub ? 26.5 : 31} textLength="104" lengthAdjust="spacingAndGlyphs">AKSOY</text>
    {sub && <text class="logo__s" x="0.6" y="38" textLength="103" lengthAdjust="spacing">KESİCİ TAKIMLAR</text>}
  </svg>
</a>

<script>
  // Takımlar sırayla değişir; sonraki şerit önceden yüklenir. Hareket azaltılmışsa ilk takım sabit durur.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-logo3d]').forEach((box) => {
    const items = [...box.querySelectorAll<HTMLElement>('.lm')];
    if (reduce || items.length < 2) return;
    const load = (el: HTMLElement) => { if (!el.style.backgroundImage) el.style.backgroundImage = `url(${el.dataset.bg})`; };
    let i = 0;
    const next = () => {
      const j = (i + 1) % items.length;
      load(items[(j + 1) % items.length]);
      items[i].classList.remove('is-on');
      items[j].classList.add('is-on');
      i = j;
    };
    addEventListener('load', () => { load(items[1]); setInterval(() => { if (!document.hidden) next(); }, 3600); }, { once: true });
  });
</script>
