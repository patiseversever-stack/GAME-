+/** Süre toplamı (arayüz her tikte çağırır): sabotaj sonrası kalan süre en az 3 sn. */
+export function questionTime(T, clock, elapsed = 0) {
+	const extra = clock ? clock.extra : 0;
+	return Math.max(T.time + extra, elapsed + (extra < 0 ? 3 : 0));
+}
+
+// ------------------------------------------------------------------------ varsayılan DOM uygulayıcı
+// Arayüz `ui.jokerEffect(effect, ctx)` tanımlayıp true dönerse bu kısım kullanılmaz.
+// Seçiciler soru kartının mevcut sınıflarına dayanır (.fl-opt, .fl-range, .fl-key); bulunamazsa sessizce geçer.
