-+// hepsini `Q_ALL` olarak dışa aktarır. esbuild içe aktarmaları derleme zamanında çözdüğü için
-+// dosya yokken içe aktarma yazamayız. Birleştirme sırasında koordinatör şu iki satırı açar:
-+//
-+//   import { Q_ALL } from './q/index.js';      // (1) yukarıya
-+//   const EXTRA = Q_ALL;                        // (2) aşağıdaki boş diziyi değiştirir
-+//
-+// Kimlikler tekrar ederse ilk görülen kalır; tipi olmayan sorular maçta zaten elenir.
-+
-+import { QUESTIONS as BASE } from './questions.js';
-+
-+const EXTRA = [];
-+
-+const seen = new Set();
-+export const QUESTIONS = [...BASE, ...EXTRA].filter((q) => {
-+	if (!q || !q.id || seen.has(q.id)) return false;
-+	seen.add(q.id);
