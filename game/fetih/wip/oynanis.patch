+			accuracy: this.stat.map((s) => (s.q ? s.correct / s.q : 0)),
+			asked: this.stat.map((s) => s.q),
+			jokers: { ...this.jokerUse },
+		};
+	}
 }
diff --git a/game/fetih/src/game/net.js b/game/fetih/src/game/net.js
