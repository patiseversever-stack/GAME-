---
import Icon from './Icon.astro';
const quick = ['CNMG 120408', 'MGMN 300', 'APMT 1604', 'U-matkap', 'Parmak freze', 'Kılavuz M8', 'ER32'];
---
<div class="search" data-search role="dialog" aria-modal="true" aria-label="Ürün arama" aria-hidden="true">
  <div class="search__panel">
    <div class="search__bar">
      <Icon name="search" />
      <input type="search" data-search-input role="combobox" aria-expanded="false" aria-autocomplete="list" aria-label="Ürün kodu veya adıyla ara" placeholder="Kod veya ürün adı: CNMG, elmas uç, klavuz…" autocomplete="off" spellcheck="false" aria-controls="arama-sonuc" />
      <kbd>Esc</kbd>
    </div>
    <div class="search__results" id="arama-sonuc" data-search-results>
      <div class="search__hint">
        <span class="eyebrow">Hızlı arama</span>
        <div class="search__chips">{quick.map((q) => <button type="button" data-search-chip>{q}</button>)}</div>
      </div>
    </div>
  </div>
</div>
