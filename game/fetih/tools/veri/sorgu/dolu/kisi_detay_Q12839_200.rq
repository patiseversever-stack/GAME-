# Kişi ayrıntıları; wd:Q12839 wd:Q18765 wd:Q27694 wd:Q31564 wd:Q44118 wd:Q46932 wd:Q47007 wd:Q57760 wd:Q59080 wd:Q61127 wd:Q63720 wd:Q65332 wd:Q68359 wd:Q75857 wd:Q77039 wd:Q77665 wd:Q80764 wd:Q83275 wd:Q104392 wd:Q110126 wd:Q113245 wd:Q122346 wd:Q126693 wd:Q128906 wd:Q156638 wd:Q159378 wd:Q164578 wd:Q164745 wd:Q165648 wd:Q181938 wd:Q192974 wd:Q193534 wd:Q198770 wd:Q201900 wd:Q202569 wd:Q203768 wd:Q209992 wd:Q215577 wd:Q217915 wd:Q230291 wd:Q232745 wd:Q233932 wd:Q234289 wd:Q236047 wd:Q237378 wd:Q237429 wd:Q238046 wd:Q238091 wd:Q249206 wd:Q253401 wd:Q256292 wd:Q262203 wd:Q270698 wd:Q270709 wd:Q272724 wd:Q278864 wd:Q279436 wd:Q284359 wd:Q285685 wd:Q294365 wd:Q297285 wd:Q297474 wd:Q297557 wd:Q298139 wd:Q298419 wd:Q298448 wd:Q298981 wd:Q299215 wd:Q299732 wd:Q310199 wd:Q311259 wd:Q311826 wd:Q313474 wd:Q314179 wd:Q314784 wd:Q315172 wd:Q315309 wd:Q315888 wd:Q316336 wd:Q316443 wd:Q317011 wd:Q317704 wd:Q318461 wd:Q319461 wd:Q319614 wd:Q319635 wd:Q319678 wd:Q319684 wd:Q319700 wd:Q319907 wd:Q321572 wd:Q327142 wd:Q327261 wd:Q328765 wd:Q330110 wd:Q331711 wd:Q331896 wd:Q334140 wd:Q335428 wd:Q337500 wd:Q345538 wd:Q347118 wd:Q348199 wd:Q351670 wd:Q355416 wd:Q360160 wd:Q361311 wd:Q365930 wd:Q366292 wd:Q366307 wd:Q366692 wd:Q367350 wd:Q369930 wd:Q377432 wd:Q378275 wd:Q378902 wd:Q379595 wd:Q388904 wd:Q390123 wd:Q434923 wd:Q435749 wd:Q437197 wd:Q441311 wd:Q442656 wd:Q444318 wd:Q447589 wd:Q459104 wd:Q461073 wd:Q464689 wd:Q465181 wd:Q468099 wd:Q470210 wd:Q511943 wd:Q529665 wd:Q621548 wd:Q642614 wd:Q715618 wd:Q718581 wd:Q724172 wd:Q763465 wd:Q822762 wd:Q858026 wd:Q936842 wd:Q957091 wd:Q982838 wd:Q983501 wd:Q1136761 wd:Q1206951 wd:Q1251392 wd:Q1259496 wd:Q1262212 wd:Q1271784 wd:Q1395724 wd:Q1401328 wd:Q2043015 wd:Q2157934 wd:Q2423137 wd:Q2423343 wd:Q2425979 wd:Q2505089 wd:Q2606870 wd:Q2682334 wd:Q2745815 wd:Q2919042 wd:Q2977143 wd:Q3191617 wd:Q3374659 wd:Q3574447 wd:Q6052351 wd:Q6059113 wd:Q6080205 wd:Q6088244 wd:Q6088718 wd:Q13860876 wd:Q15304882 wd:Q17046812 wd:Q17708749 wd:Q19402598 wd:Q19612578 wd:Q19613570 wd:Q20988356 wd:Q21083288 wd:Q21998497 wd:Q22007007 wd:Q23063190 wd:Q26719541 wd:Q26965570 wd:Q28778443 wd:Q29047921 wd:Q31190494 wd:Q50628268 wd:Q53280628 wd:Q53394040 wd:Q55955918 wd:Q56788302 wd:Q57415806 wd:Q65552955 wd:Q92379963 wd:Q97725322 wd:Q113184832 yerine getir.mjs en çok 400 kişilik bir öbek koyar.
# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q12839 wd:Q18765 wd:Q27694 wd:Q31564 wd:Q44118 wd:Q46932 wd:Q47007 wd:Q57760 wd:Q59080 wd:Q61127 wd:Q63720 wd:Q65332 wd:Q68359 wd:Q75857 wd:Q77039 wd:Q77665 wd:Q80764 wd:Q83275 wd:Q104392 wd:Q110126 wd:Q113245 wd:Q122346 wd:Q126693 wd:Q128906 wd:Q156638 wd:Q159378 wd:Q164578 wd:Q164745 wd:Q165648 wd:Q181938 wd:Q192974 wd:Q193534 wd:Q198770 wd:Q201900 wd:Q202569 wd:Q203768 wd:Q209992 wd:Q215577 wd:Q217915 wd:Q230291 wd:Q232745 wd:Q233932 wd:Q234289 wd:Q236047 wd:Q237378 wd:Q237429 wd:Q238046 wd:Q238091 wd:Q249206 wd:Q253401 wd:Q256292 wd:Q262203 wd:Q270698 wd:Q270709 wd:Q272724 wd:Q278864 wd:Q279436 wd:Q284359 wd:Q285685 wd:Q294365 wd:Q297285 wd:Q297474 wd:Q297557 wd:Q298139 wd:Q298419 wd:Q298448 wd:Q298981 wd:Q299215 wd:Q299732 wd:Q310199 wd:Q311259 wd:Q311826 wd:Q313474 wd:Q314179 wd:Q314784 wd:Q315172 wd:Q315309 wd:Q315888 wd:Q316336 wd:Q316443 wd:Q317011 wd:Q317704 wd:Q318461 wd:Q319461 wd:Q319614 wd:Q319635 wd:Q319678 wd:Q319684 wd:Q319700 wd:Q319907 wd:Q321572 wd:Q327142 wd:Q327261 wd:Q328765 wd:Q330110 wd:Q331711 wd:Q331896 wd:Q334140 wd:Q335428 wd:Q337500 wd:Q345538 wd:Q347118 wd:Q348199 wd:Q351670 wd:Q355416 wd:Q360160 wd:Q361311 wd:Q365930 wd:Q366292 wd:Q366307 wd:Q366692 wd:Q367350 wd:Q369930 wd:Q377432 wd:Q378275 wd:Q378902 wd:Q379595 wd:Q388904 wd:Q390123 wd:Q434923 wd:Q435749 wd:Q437197 wd:Q441311 wd:Q442656 wd:Q444318 wd:Q447589 wd:Q459104 wd:Q461073 wd:Q464689 wd:Q465181 wd:Q468099 wd:Q470210 wd:Q511943 wd:Q529665 wd:Q621548 wd:Q642614 wd:Q715618 wd:Q718581 wd:Q724172 wd:Q763465 wd:Q822762 wd:Q858026 wd:Q936842 wd:Q957091 wd:Q982838 wd:Q983501 wd:Q1136761 wd:Q1206951 wd:Q1251392 wd:Q1259496 wd:Q1262212 wd:Q1271784 wd:Q1395724 wd:Q1401328 wd:Q2043015 wd:Q2157934 wd:Q2423137 wd:Q2423343 wd:Q2425979 wd:Q2505089 wd:Q2606870 wd:Q2682334 wd:Q2745815 wd:Q2919042 wd:Q2977143 wd:Q3191617 wd:Q3374659 wd:Q3574447 wd:Q6052351 wd:Q6059113 wd:Q6080205 wd:Q6088244 wd:Q6088718 wd:Q13860876 wd:Q15304882 wd:Q17046812 wd:Q17708749 wd:Q19402598 wd:Q19612578 wd:Q19613570 wd:Q20988356 wd:Q21083288 wd:Q21998497 wd:Q22007007 wd:Q23063190 wd:Q26719541 wd:Q26965570 wd:Q28778443 wd:Q29047921 wd:Q31190494 wd:Q50628268 wd:Q53280628 wd:Q53394040 wd:Q55955918 wd:Q56788302 wd:Q57415806 wd:Q65552955 wd:Q92379963 wd:Q97725322 wd:Q113184832 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
