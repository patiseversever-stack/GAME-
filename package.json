    "@remotion/noise": "4.0.531",
    "@remotion/paths": "4.0.531",
    "@remotion/renderer": "4.0.531",
    "@remotion/shapes": "4.0.531",
    "@remotion/transitions": "4.0.531",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
