---
// Blog kapak çizimi: ürün çizimlerinden biri ya da kesme hızı şeması (iş parçası, D, n, Vc).
import { drawingSvg } from '../../lib/drawings';
import type { Post } from '../../data/posts';

interface Props { art: Post['art']; title?: string }
const { art, title } = Astro.props;

const grid = `<g stroke="#7d858f" stroke-opacity=".09" stroke-width=".5">${Array.from({ length: 9 }, (_, i) => `<line x1="${i * 25}" y1="0" x2="${i * 25}" y2="150"/>`).join('')}${Array.from({ length: 7 }, (_, i) => `<line x1="0" y1="${i * 25}" x2="200" y2="${i * 25}"/>`).join('')}</g>`;

// Kesme hızı şeması: saat yönünde dönen Ø D iş parçası, 3 yönünde temas eden uç, temas noktasında teğet Vc.
const vcSvg = `<svg viewBox="0 0 200 150" ${title ? 'role="img"' : 'aria-hidden="true"'} xmlns="http://www.w3.org/2000/svg">${title ? `<title>${title}</title>` : ''}${grid}
<circle cx="80" cy="78" r="46" fill="#22272e" stroke="#a9b0b9" stroke-width=".7"/>
<circle cx="80" cy="78" r="38" fill="none" stroke="#59616b" stroke-width=".5" stroke-dasharray="1.5 2.5"/>
<path d="M44 52a44 44 0 0 1 40-20" fill="none" stroke="#7d858f" stroke-opacity=".5" stroke-width="1.2" stroke-linecap="round"/>
<g stroke="#59616b" stroke-width=".5" stroke-dasharray="7 2 1.5 2"><line x1="24" y1="78" x2="136" y2="78"/><line x1="80" y1="22" x2="80" y2="134"/></g>
<path d="M76 78h8M80 74v8" stroke="#a9b0b9" stroke-width=".6"/>
<path d="M26.8 68.6A54 54 0 0 1 61.5 27.3" fill="none" stroke="#a9b0b9" stroke-width=".8"/>
<polygon points="65.3,25.9 59.7,31.1 57.7,25.5" fill="#a9b0b9"/>
<text x="31" y="40" font-family="IBM Plex Mono, monospace" font-size="9" fill="#cdd2d8">n</text>
<g stroke="#59616b" stroke-width=".5"><line x1="34" y1="112" x2="34" y2="142"/><line x1="126" y1="96" x2="126" y2="142"/></g>
<line x1="37" y1="137" x2="123" y2="137" stroke="#a9b0b9" stroke-width=".6"/>
<polygon points="34,137 40,135 40,139" fill="#a9b0b9"/><polygon points="126,137 120,135 120,139" fill="#a9b0b9"/>
<rect x="72" y="129" width="16" height="9" fill="#111316"/>
<text x="80" y="136" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="7.5" fill="#cdd2d8">ØD</text>
<rect x="148" y="63" width="54" height="30" fill="#1b1f24" stroke="#a9b0b9" stroke-width=".6"/>
<rect x="151" y="57" width="16" height="8" rx="1" fill="#262b31" stroke="#7d858f" stroke-width=".5"/>
<polygon points="127,78 140,65 154,70 141,84" fill="#d9a441" stroke="#f0c266" stroke-width=".5"/>
<circle cx="146" cy="74" r="2.2" fill="#1a1408"/>
<path d="M129 74q5-9-2-15q-6-5 0-11" fill="none" stroke="#d9a441" stroke-width=".9" stroke-linecap="round" opacity=".8"/>
<line x1="121" y1="50" x2="121" y2="99" stroke="#d9a441" stroke-width="1.1"/>
<polygon points="121,106 117.5,98 124.5,98" fill="#d9a441"/>
<text x="128" y="112" font-family="IBM Plex Mono, monospace" font-size="9" fill="#f0c266">Vc</text>
<text x="194" y="144" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="6.5" letter-spacing=".6" fill="#59616b">${art.label}</text>
</svg>`;

const svg = art.drawing === 'vc' ? vcSvg : drawingSvg(art.drawing, art.shape, { grid: true, label: art.label, title });
---
<Fragment set:html={svg} />
