---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { waLink } from '../data/site';
import '../styles/content.css';

const wa = waLink('Merhaba Aksoy Kesici Takımlar, sitede aradığım sayfayı bulamadım. Aradığım ürün: …');
const links = [
  { href: '/', label: 'Ana sayfa' },
  { href: '/urunler', label: 'Ürünler' },
  { href: '/teknik-araclar', label: 'Teknik araçlar' },
  { href: '/blog', label: 'Blog' },
  { href: '/iletisim', label: 'İletişim' },
];

// Ölçü kontrol paftası: nominal delik parçanın üzerinde, ölçülen delik paftanın dışında.
const grid = Array.from({ length: 25 }, (_, i) => `<line x1="${i * 20}" y1="0" x2="${i * 20}" y2="300"/>`).join('') +
  Array.from({ length: 16 }, (_, i) => `<line x1="0" y1="${i * 20}" x2="480" y2="${i * 20}"/>`).join('');
---
<Base title="Sayfa bulunamadı (404)" description="Aradığınız sayfa bulunamadı. Ürün kataloğuna dönün, kodla arayın ya da WhatsApp’tan sorun." theme="dark" header="dark" noindex footerCta={false}>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap">
      <div class="nf__grid">
        <div>
          <span class="eyebrow eyebrow--tin">Hata 404 · Ölçü kontrol raporu</span>
          <p class="nf__code" aria-hidden="true">404</p>
          <h1 id="nf-title">Bu ölçü toleransın dışında.</h1>
          <p class="nf__lead">Aradığınız sayfa taşınmış, kaldırılmış ya da adres yanlış yazılmış olabilir. Ürün kodunu arayın, kataloğa dönün ya da doğrudan bize sorun.</p>
          <div class="nf__actions">
            <a class="btn btn--tin" href="/urunler" data-magnetic><Icon name="grid" /> Kataloğa dön</a>
            <button class="btn btn--ghost" type="button" data-search-open><Icon name="search" /> Kodla ara</button>
            <a class="btn btn--wa" href={wa} target="_blank" rel="noopener" data-wa="404"><Icon name="whatsapp" /> WhatsApp’tan sor</a>
          </div>
        </div>

        <figure class="nf__sheet" aria-label="Teknik çizim: nominal delik parçanın üzerinde, ölçülen delik paftanın dışında">
          <svg viewBox="0 0 480 300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <g stroke="#ffffff" stroke-opacity=".035" stroke-width=".6" set:html={grid} />
            <!-- Parça -->
            <rect x="48" y="58" width="260" height="176" rx="4" fill="#16191d" stroke="#7d858f" stroke-width="1" />
            <path d="M48 214h260" stroke="#59616b" stroke-width=".6" stroke-dasharray="6 4" />
            <!-- Nominal delik -->
            <circle cx="178" cy="140" r="58" fill="none" stroke="#59616b" stroke-width=".8" stroke-dasharray="5 4" />
            <circle cx="178" cy="140" r="50" fill="#0b0c0e" stroke="#a9b0b9" stroke-width="1.2" />
            <g stroke="#7d858f" stroke-width=".7" stroke-dasharray="14 3 2 3">
              <line x1="104" y1="140" x2="252" y2="140" />
              <line x1="178" y1="66" x2="178" y2="214" />
            </g>
            <!-- Ölçü: Ø nominal -->
            <path d="M213 105 300 40h76" fill="none" stroke="#a9b0b9" stroke-width=".8" />
            <polygon points="213,105 222,95 225,101" fill="#a9b0b9" />
            <text x="304" y="34" font-family="IBM Plex Mono, monospace" font-size="13" fill="#e7e9ec" letter-spacing=".5">Ø 200 H7</text>
            <!-- Ölçülen delik: paftanın dışında -->
            <g class="nf__probe">
              <circle cx="404" cy="196" r="34" fill="none" stroke="#d9a441" stroke-width="1.4" stroke-dasharray="6 4" />
              <path d="M392 196h24M404 184v24" stroke="#d9a441" stroke-width="1.2" />
            </g>
            <!-- Sapma oku -->
            <line x1="178" y1="140" x2="364" y2="187" stroke="#d9a441" stroke-width="1" stroke-dasharray="3 3" />
            <polygon points="370,188 359,190 362,182" fill="#d9a441" />
            <text x="236" y="186" font-family="IBM Plex Mono, monospace" font-size="10.5" fill="#f0c266" letter-spacing=".8" transform="rotate(14 236 186)">SAPMA: SAYFA YOK</text>
            <text x="404" y="250" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" fill="#d9a441" letter-spacing="1">ÖLÇÜLEN</text>
            <!-- Konum toleransı çerçevesi -->
            <g font-family="IBM Plex Mono, monospace" font-size="11" fill="#cdd2d8">
              <rect x="48" y="252" width="174" height="26" fill="#111316" stroke="#7d858f" stroke-width=".8" />
              <line x1="80" y1="252" x2="80" y2="278" stroke="#7d858f" stroke-width=".8" />
              <line x1="180" y1="252" x2="180" y2="278" stroke="#7d858f" stroke-width=".8" />
              <circle cx="64" cy="265" r="6" fill="none" stroke="#cdd2d8" stroke-width=".9" />
              <path d="M56 265h16M64 257v16" stroke="#cdd2d8" stroke-width=".9" />
              <text x="92" y="269">Ø 0,02</text>
              <text x="196" y="269">A</text>
            </g>
            <text x="470" y="290" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="9" fill="#59616b" letter-spacing="1">PAFTA 404 · ÖLÇEK 1:1</text>
          </svg>
          <p class="nf__stamp" aria-hidden="true">Tolerans dışı<small>Red · 404</small></p>
          <dl class="nf__report">
            <div><dt>Parça</dt><dd data-nf-path>Bu sayfa</dd></div>
            <div><dt>Nominal</dt><dd>Mevcut adres</dd></div>
            <div><dt>Ölçülen</dt><dd class="is-bad">404</dd></div>
            <div><dt>Sonuç</dt><dd class="is-bad">Red</dd></div>
          </dl>
        </figure>
      </div>

      <nav class="nf__links" aria-label="Sık kullanılan sayfalar">
        {links.map((l, i) => <a href={l.href}>{l.label}<span>{String(i).padStart(2, '0')}</span></a>)}
      </nav>
    </div>
  </section>

  <script>
    // Raporun "Parça" satırına istenen adresi yaz (yalnızca görüntü, hiçbir yere gönderilmez).
    const el = document.querySelector<HTMLElement>('[data-nf-path]');
    if (el && location.pathname && location.pathname !== '/404') {
      let p = location.pathname;
      try { p = decodeURIComponent(p); } catch { /* bozuk adres: olduğu gibi göster */ }
      el.textContent = p.length > 28 ? `${p.slice(0, 27)}…` : p;
      el.title = p;
    }
  </script>
</Base>
