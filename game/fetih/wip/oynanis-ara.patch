-+	for (const q of QUESTIONS) {
-+		out.cat[q.cat] = (out.cat[q.cat] || 0) + 1;
-+		out.type[q.type] = (out.type[q.type] || 0) + 1;
-+		out.diff[q.diff] = (out.diff[q.diff] || 0) + 1;
