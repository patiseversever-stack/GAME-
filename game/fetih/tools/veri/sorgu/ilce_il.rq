# İlçe öğelerinin bağlı olduğu il.
# (a) P131 deyimleri (kerte, başlangıç/bitiş ile); hedef il mi (Q48336), ilçe mi, yoksa bir ilin başkenti mi (P36)?
# (b) Öğenin kendisi bir ilin başkenti (il P36 → öğe) ise o il.
SELECT ?d ?tur ?hedef ?derece ?baslangic ?bitis ?hedefIl ?hedefIlce ?baskentIl WHERE {
  ?d wdt:P31 wd:Q1147395 .
  {
    ?d p:P131 ?s .
    ?s ps:P131 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?s pq:P580 ?baslangic }
    OPTIONAL { ?s pq:P582 ?bitis }
    BIND(EXISTS { ?hedef wdt:P31 wd:Q48336 } AS ?hedefIl)
    BIND(EXISTS { ?hedef wdt:P31 wd:Q1147395 } AS ?hedefIlce)
    OPTIONAL { ?baskentIl wdt:P36 ?hedef ; wdt:P31 wd:Q48336 . }
    BIND("P131" AS ?tur)
  } UNION {
    ?hedef wdt:P36 ?d ; wdt:P31 wd:Q48336 .
    BIND("baskent" AS ?tur)
  }
}
ORDER BY ?d ?tur ?hedef ?derece ?baslangic ?bitis ?baskentIl
