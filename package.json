{
  "name": "gece-postasi-yukleme",
  "version": "1.0.0",
  "private": true,
  "description": "Gece Postası dikey fragman/yükleme filmi: Remotion ile kodla çizilen sinematik sekanslar.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio remotion/index.ts",
