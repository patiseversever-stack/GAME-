  </script>
  <script>
    // Mini hesaplayıcı: n = Vc·1000 / (π·D)
    const root = document.querySelector<HTMLElement>('[data-minicalc]');
    if (root) {
      const vc = root.querySelector<HTMLInputElement>('[data-in="vc"]')!;
      const d = root.querySelector<HTMLInputElement>('[data-in="d"]')!;
      const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
      const fmt = new Intl.NumberFormat('tr-TR');
      const upd = () => {
        const v = +vc.value, dd = +d.value;
        out('vc').textContent = `${v} m/dk`;
        out('d').textContent = `${dd} mm`;
        out('n').textContent = fmt.format(Math.round((v * 1000) / (Math.PI * dd)));
        for (const el of [vc, d]) el.style.setProperty('--p', `${((+el.value - +el.min) / (+el.max - +el.min)) * 100}%`);
      };
      vc.addEventListener('input', upd);
      d.addEventListener('input', upd);
      upd();
    }
    // Kategori kartlarında imleci izleyen ışık
    document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
    });
  </script>
</Base>
