+	for (let i = 0; i < n; i++) e.tone('sine', base * Math.pow(1.5, i % 3) * (1 + (i >> 1) * 0.5), 0, t + i * 0.045, 0.22, vol * (1 - i * 0.12), { a: 0.002 });
+};
