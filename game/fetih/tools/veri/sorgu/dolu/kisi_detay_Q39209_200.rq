# Kişi ayrıntıları; wd:Q39209 wd:Q46561 wd:Q60841 wd:Q61398 wd:Q80454 wd:Q99297 wd:Q106748 wd:Q126449 wd:Q129575 wd:Q153079 wd:Q167543 wd:Q187272 wd:Q242334 wd:Q252734 wd:Q258656 wd:Q261691 wd:Q263235 wd:Q265814 wd:Q274434 wd:Q277568 wd:Q282782 wd:Q283026 wd:Q283908 wd:Q297504 wd:Q297526 wd:Q307737 wd:Q317988 wd:Q318079 wd:Q328238 wd:Q334859 wd:Q335413 wd:Q344193 wd:Q357260 wd:Q362534 wd:Q366685 wd:Q366772 wd:Q367697 wd:Q375687 wd:Q382163 wd:Q384801 wd:Q388757 wd:Q388979 wd:Q388991 wd:Q390560 wd:Q391524 wd:Q401118 wd:Q401209 wd:Q401411 wd:Q401541 wd:Q434159 wd:Q437021 wd:Q441580 wd:Q448164 wd:Q448297 wd:Q449254 wd:Q452096 wd:Q453455 wd:Q460204 wd:Q462745 wd:Q463358 wd:Q463834 wd:Q463901 wd:Q463916 wd:Q464186 wd:Q465465 wd:Q466038 wd:Q472508 wd:Q496959 wd:Q509775 wd:Q512707 wd:Q531408 wd:Q541542 wd:Q542184 wd:Q545945 wd:Q551641 wd:Q551841 wd:Q554001 wd:Q557613 wd:Q557642 wd:Q558317 wd:Q560630 wd:Q560701 wd:Q561445 wd:Q607246 wd:Q614470 wd:Q623087 wd:Q623135 wd:Q623586 wd:Q660508 wd:Q660534 wd:Q708334 wd:Q710866 wd:Q715652 wd:Q715917 wd:Q717115 wd:Q728586 wd:Q729999 wd:Q730299 wd:Q735539 wd:Q735556 wd:Q735585 wd:Q738962 wd:Q743810 wd:Q820143 wd:Q919288 wd:Q919302 wd:Q922153 wd:Q922847 wd:Q941740 wd:Q945364 wd:Q946473 wd:Q949051 wd:Q953171 wd:Q965750 wd:Q977935 wd:Q982389 wd:Q1016283 wd:Q1053260 wd:Q1085744 wd:Q1280502 wd:Q1294015 wd:Q1300929 wd:Q1372826 wd:Q1373349 wd:Q1378770 wd:Q1394807 wd:Q1396157 wd:Q1399210 wd:Q1492533 wd:Q1572451 wd:Q1800576 wd:Q1977386 wd:Q2037568 wd:Q2064734 wd:Q2480875 wd:Q2503503 wd:Q2505360 wd:Q2562396 wd:Q2610534 wd:Q2620193 wd:Q2666876 wd:Q2735950 wd:Q2746974 wd:Q2900391 wd:Q2947184 wd:Q2999351 wd:Q3073358 wd:Q3087653 wd:Q3124589 wd:Q3180968 wd:Q3296846 wd:Q3299308 wd:Q3478799 wd:Q3760333 wd:Q3826903 wd:Q4436934 wd:Q4436960 wd:Q4445392 wd:Q4892993 wd:Q5201950 wd:Q6052158 wd:Q6064958 wd:Q6087288 wd:Q6087410 wd:Q6098459 wd:Q6380345 wd:Q6393280 wd:Q6638863 wd:Q7940222 wd:Q8063474 wd:Q10967747 wd:Q12812195 wd:Q13574559 wd:Q15388533 wd:Q16911421 wd:Q17045869 wd:Q17045884 wd:Q17305804 wd:Q17430684 wd:Q17430708 wd:Q17462365 wd:Q19310495 wd:Q20472885 wd:Q20730476 wd:Q23063266 wd:Q26402567 wd:Q27950774 wd:Q29515786 wd:Q29998546 wd:Q47487632 wd:Q50673634 wd:Q53252754 wd:Q63168067 wd:Q65219989 wd:Q83544153 wd:Q97320541 wd:Q108304158 wd:Q111613340 wd:Q116920755 wd:Q118799181 yerine getir.mjs en çok 400 kişilik bir öbek koyar.
# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q39209 wd:Q46561 wd:Q60841 wd:Q61398 wd:Q80454 wd:Q99297 wd:Q106748 wd:Q126449 wd:Q129575 wd:Q153079 wd:Q167543 wd:Q187272 wd:Q242334 wd:Q252734 wd:Q258656 wd:Q261691 wd:Q263235 wd:Q265814 wd:Q274434 wd:Q277568 wd:Q282782 wd:Q283026 wd:Q283908 wd:Q297504 wd:Q297526 wd:Q307737 wd:Q317988 wd:Q318079 wd:Q328238 wd:Q334859 wd:Q335413 wd:Q344193 wd:Q357260 wd:Q362534 wd:Q366685 wd:Q366772 wd:Q367697 wd:Q375687 wd:Q382163 wd:Q384801 wd:Q388757 wd:Q388979 wd:Q388991 wd:Q390560 wd:Q391524 wd:Q401118 wd:Q401209 wd:Q401411 wd:Q401541 wd:Q434159 wd:Q437021 wd:Q441580 wd:Q448164 wd:Q448297 wd:Q449254 wd:Q452096 wd:Q453455 wd:Q460204 wd:Q462745 wd:Q463358 wd:Q463834 wd:Q463901 wd:Q463916 wd:Q464186 wd:Q465465 wd:Q466038 wd:Q472508 wd:Q496959 wd:Q509775 wd:Q512707 wd:Q531408 wd:Q541542 wd:Q542184 wd:Q545945 wd:Q551641 wd:Q551841 wd:Q554001 wd:Q557613 wd:Q557642 wd:Q558317 wd:Q560630 wd:Q560701 wd:Q561445 wd:Q607246 wd:Q614470 wd:Q623087 wd:Q623135 wd:Q623586 wd:Q660508 wd:Q660534 wd:Q708334 wd:Q710866 wd:Q715652 wd:Q715917 wd:Q717115 wd:Q728586 wd:Q729999 wd:Q730299 wd:Q735539 wd:Q735556 wd:Q735585 wd:Q738962 wd:Q743810 wd:Q820143 wd:Q919288 wd:Q919302 wd:Q922153 wd:Q922847 wd:Q941740 wd:Q945364 wd:Q946473 wd:Q949051 wd:Q953171 wd:Q965750 wd:Q977935 wd:Q982389 wd:Q1016283 wd:Q1053260 wd:Q1085744 wd:Q1280502 wd:Q1294015 wd:Q1300929 wd:Q1372826 wd:Q1373349 wd:Q1378770 wd:Q1394807 wd:Q1396157 wd:Q1399210 wd:Q1492533 wd:Q1572451 wd:Q1800576 wd:Q1977386 wd:Q2037568 wd:Q2064734 wd:Q2480875 wd:Q2503503 wd:Q2505360 wd:Q2562396 wd:Q2610534 wd:Q2620193 wd:Q2666876 wd:Q2735950 wd:Q2746974 wd:Q2900391 wd:Q2947184 wd:Q2999351 wd:Q3073358 wd:Q3087653 wd:Q3124589 wd:Q3180968 wd:Q3296846 wd:Q3299308 wd:Q3478799 wd:Q3760333 wd:Q3826903 wd:Q4436934 wd:Q4436960 wd:Q4445392 wd:Q4892993 wd:Q5201950 wd:Q6052158 wd:Q6064958 wd:Q6087288 wd:Q6087410 wd:Q6098459 wd:Q6380345 wd:Q6393280 wd:Q6638863 wd:Q7940222 wd:Q8063474 wd:Q10967747 wd:Q12812195 wd:Q13574559 wd:Q15388533 wd:Q16911421 wd:Q17045869 wd:Q17045884 wd:Q17305804 wd:Q17430684 wd:Q17430708 wd:Q17462365 wd:Q19310495 wd:Q20472885 wd:Q20730476 wd:Q23063266 wd:Q26402567 wd:Q27950774 wd:Q29515786 wd:Q29998546 wd:Q47487632 wd:Q50673634 wd:Q53252754 wd:Q63168067 wd:Q65219989 wd:Q83544153 wd:Q97320541 wd:Q108304158 wd:Q111613340 wd:Q116920755 wd:Q118799181 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
