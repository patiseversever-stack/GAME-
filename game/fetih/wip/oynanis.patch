+export const isChoice = (v) => !!v && Array.isArray(v.opts) && typeof v.right === 'number' && v.opts.length >= 2;
+
+/** Bu joker bu soru tipinde kullanılabilir mi? { ok, why }. */
+export function support(id, T, v) {
+	const no = (why) => ({ ok: false, why });
+	const ok = { ok: true };
+	if (!T) return no('Soru yok');
+	if (id === 'sure' || id === 'sabotaj' || id === 'kalkan') return ok;
+	if (id === 'ikinci') return T.kind === 'exact' ? ok : no('Tahmin sorusunda işe yaramaz');
+	if (T.jokers) return T.jokers.includes(id) ? ok : no('Bu soru tipinde yok');
+	if (isChoice(v)) return id === 'yari' && v.opts.length < 3 ? no('Zaten iki şık var') : ok;
+	if (id === 'yari' || id === 'kahin') {
+		if (v?.q?.type === 'tf' || (typeof v?.right === 'number' && !v.opts)) return id === 'kahin' ? ok : no('Zaten iki şık var');
+		if (v?.q?.type === 'num') return ok;
+		if (v?.q?.type === 'pin') return ok;
+		if (v?.word) return ok;
+	}
+	return no('Bu soru tipinde yok');
+}
