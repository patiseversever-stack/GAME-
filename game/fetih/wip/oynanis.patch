+			this.el = document.createElement('div');
+			this.el.className = 'fl-jfallback';
+			this.el.style.cssText = 'position:absolute;left:50%;bottom:10px;transform:translateX(-50%);display:flex;gap:6px;z-index:40;pointer-events:auto';
+			this.el.addEventListener('pointerdown', (e) => e.stopPropagation());
+			this.el.addEventListener('click', (e) => {
+				const b = e.target.closest('button[data-j]');
+				if (b && !b.disabled) this.onTap(b.dataset.j);
+			});
+			(this.ui?.el || document.body).appendChild(this.el);
+		}
+		this.el.style.display = 'flex';
+		this.el.innerHTML = list
+			.map(
+				(j) =>
+					`<button data-j="${j.id}" ${j.usable ? '' : 'disabled'} title="${j.name}: ${j.why || j.desc}" style="width:44px;height:44px;border-radius:14px;border:2px solid ${j.armed ? '#fff' : 'rgba(255,255,255,.35)'};background:${j.color};opacity:${j.usable ? 1 : 0.4};position:relative;padding:0"><svg viewBox="0 0 24 24" width="24" height="24" style="fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"><path d="${j.icon}"/></svg><b style="position:absolute;right:-4px;top:-5px;background:#101a33;color:#fff;border-radius:9px;min-width:17px;font:700 11px Fredoka,system-ui;padding:1px 3px">${j.left}</b></button>`,
+			)
+			.join('');
+	}
+
+	hide() {
+		if (this.el) this.el.style.display = 'none';
+	}
