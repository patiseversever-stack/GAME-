---
// AKSOY işareti: 80° eşkenar dörtgen kesici uç + merkez deliği + kesme kenarında TiN parıltısı.
interface Props { sub?: boolean; class?: string }
const { sub = true, class: cls } = Astro.props;
---
<a href="/" class:list={['logo', cls]} aria-label="Aksoy Kesici Takımlar — ana sayfa">
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="lg-tin" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f6d27e" />
        <stop offset=".55" stop-color="#d9a441" />
        <stop offset="1" stop-color="#9c6f1f" />
      </linearGradient>
    </defs>
    <path d="M16 1.8 29.2 16 16 30.2 2.8 16Z" fill="url(#lg-tin)" />
    <path d="M16 6.4 24.6 16 16 25.6 7.4 16Z" fill="none" stroke="#1a1408" stroke-opacity=".35" stroke-width="1" />
    <circle cx="16" cy="16" r="3.4" fill="#0b0c0e" />
    <path d="M16 1.8 29.2 16" stroke="#fff6dc" stroke-width="1.2" stroke-linecap="round" opacity=".9" />
  </svg>
  <span>
    <span class="logo__word">AKSOY</span>
    {sub && <span class="logo__sub">KESİCİ TAKIMLAR</span>}
  </span>
</a>
