# Kişi ayrıntıları; wd:Q4899 wd:Q47699 wd:Q55460 wd:Q59930 wd:Q59981 wd:Q60271 wd:Q61655 wd:Q76322 wd:Q77005 wd:Q115455 wd:Q124297 wd:Q187282 wd:Q197690 wd:Q234377 wd:Q246938 wd:Q247611 wd:Q248059 wd:Q255545 wd:Q259179 wd:Q262078 wd:Q262642 wd:Q266339 wd:Q269182 wd:Q274048 wd:Q276098 wd:Q282179 wd:Q288019 wd:Q289248 wd:Q298146 wd:Q307540 wd:Q311164 wd:Q312245 wd:Q312494 wd:Q313145 wd:Q315897 wd:Q317045 wd:Q318014 wd:Q318069 wd:Q328331 wd:Q331707 wd:Q334886 wd:Q339509 wd:Q342360 wd:Q343394 wd:Q343562 wd:Q347045 wd:Q347172 wd:Q347327 wd:Q348117 wd:Q350857 wd:Q352760 wd:Q352815 wd:Q353064 wd:Q361352 wd:Q365971 wd:Q366796 wd:Q381211 wd:Q381297 wd:Q390725 wd:Q401226 wd:Q401875 wd:Q401893 wd:Q423644 wd:Q430941 wd:Q439237 wd:Q440558 wd:Q440846 wd:Q452777 wd:Q459081 wd:Q459887 wd:Q464670 wd:Q464906 wd:Q464994 wd:Q465269 wd:Q467067 wd:Q467148 wd:Q467895 wd:Q468123 wd:Q469566 wd:Q469840 wd:Q470634 wd:Q471099 wd:Q476938 wd:Q507832 wd:Q507956 wd:Q510679 wd:Q512991 wd:Q529162 wd:Q531443 wd:Q539183 wd:Q539734 wd:Q543316 wd:Q546595 wd:Q552756 wd:Q558287 wd:Q558304 wd:Q560045 wd:Q595285 wd:Q604285 wd:Q705191 wd:Q708078 wd:Q709859 wd:Q714518 wd:Q715945 wd:Q717119 wd:Q721715 wd:Q722306 wd:Q727531 wd:Q728324 wd:Q730284 wd:Q732915 wd:Q735399 wd:Q735688 wd:Q738515 wd:Q738576 wd:Q739524 wd:Q740282 wd:Q852738 wd:Q927967 wd:Q936379 wd:Q943478 wd:Q946447 wd:Q948861 wd:Q965771 wd:Q982848 wd:Q1057754 wd:Q1095044 wd:Q1095287 wd:Q1190012 wd:Q1284001 wd:Q1285173 wd:Q1312312 wd:Q1330145 wd:Q1355014 wd:Q1366105 wd:Q1366693 wd:Q1373065 wd:Q1379164 wd:Q1571856 wd:Q1584707 wd:Q1654200 wd:Q1917355 wd:Q2016684 wd:Q2034890 wd:Q2084815 wd:Q2304055 wd:Q2353735 wd:Q2357350 wd:Q2427828 wd:Q2514770 wd:Q2537149 wd:Q2682344 wd:Q2682717 wd:Q2690022 wd:Q2905733 wd:Q2991195 wd:Q3054267 wd:Q3064473 wd:Q3300364 wd:Q3447475 wd:Q3706312 wd:Q3876358 wd:Q4310486 wd:Q4381410 wd:Q4436946 wd:Q4447304 wd:Q4809153 wd:Q6086970 wd:Q6087480 wd:Q6095524 wd:Q6096461 wd:Q6103622 wd:Q7034181 wd:Q8061940 wd:Q8082384 wd:Q12809521 wd:Q13045607 wd:Q13407931 wd:Q13420049 wd:Q14330482 wd:Q14551682 wd:Q14637461 wd:Q15620192 wd:Q15901932 wd:Q16017442 wd:Q17045723 wd:Q17045790 wd:Q17046466 wd:Q19610875 wd:Q19841238 wd:Q20470945 wd:Q20853404 wd:Q42281686 wd:Q48977782 wd:Q55437281 wd:Q56043430 wd:Q66133404 wd:Q69512938 wd:Q72219322 wd:Q107352615 yerine getir.mjs en çok 400 kişilik bir öbek koyar.
# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q4899 wd:Q47699 wd:Q55460 wd:Q59930 wd:Q59981 wd:Q60271 wd:Q61655 wd:Q76322 wd:Q77005 wd:Q115455 wd:Q124297 wd:Q187282 wd:Q197690 wd:Q234377 wd:Q246938 wd:Q247611 wd:Q248059 wd:Q255545 wd:Q259179 wd:Q262078 wd:Q262642 wd:Q266339 wd:Q269182 wd:Q274048 wd:Q276098 wd:Q282179 wd:Q288019 wd:Q289248 wd:Q298146 wd:Q307540 wd:Q311164 wd:Q312245 wd:Q312494 wd:Q313145 wd:Q315897 wd:Q317045 wd:Q318014 wd:Q318069 wd:Q328331 wd:Q331707 wd:Q334886 wd:Q339509 wd:Q342360 wd:Q343394 wd:Q343562 wd:Q347045 wd:Q347172 wd:Q347327 wd:Q348117 wd:Q350857 wd:Q352760 wd:Q352815 wd:Q353064 wd:Q361352 wd:Q365971 wd:Q366796 wd:Q381211 wd:Q381297 wd:Q390725 wd:Q401226 wd:Q401875 wd:Q401893 wd:Q423644 wd:Q430941 wd:Q439237 wd:Q440558 wd:Q440846 wd:Q452777 wd:Q459081 wd:Q459887 wd:Q464670 wd:Q464906 wd:Q464994 wd:Q465269 wd:Q467067 wd:Q467148 wd:Q467895 wd:Q468123 wd:Q469566 wd:Q469840 wd:Q470634 wd:Q471099 wd:Q476938 wd:Q507832 wd:Q507956 wd:Q510679 wd:Q512991 wd:Q529162 wd:Q531443 wd:Q539183 wd:Q539734 wd:Q543316 wd:Q546595 wd:Q552756 wd:Q558287 wd:Q558304 wd:Q560045 wd:Q595285 wd:Q604285 wd:Q705191 wd:Q708078 wd:Q709859 wd:Q714518 wd:Q715945 wd:Q717119 wd:Q721715 wd:Q722306 wd:Q727531 wd:Q728324 wd:Q730284 wd:Q732915 wd:Q735399 wd:Q735688 wd:Q738515 wd:Q738576 wd:Q739524 wd:Q740282 wd:Q852738 wd:Q927967 wd:Q936379 wd:Q943478 wd:Q946447 wd:Q948861 wd:Q965771 wd:Q982848 wd:Q1057754 wd:Q1095044 wd:Q1095287 wd:Q1190012 wd:Q1284001 wd:Q1285173 wd:Q1312312 wd:Q1330145 wd:Q1355014 wd:Q1366105 wd:Q1366693 wd:Q1373065 wd:Q1379164 wd:Q1571856 wd:Q1584707 wd:Q1654200 wd:Q1917355 wd:Q2016684 wd:Q2034890 wd:Q2084815 wd:Q2304055 wd:Q2353735 wd:Q2357350 wd:Q2427828 wd:Q2514770 wd:Q2537149 wd:Q2682344 wd:Q2682717 wd:Q2690022 wd:Q2905733 wd:Q2991195 wd:Q3054267 wd:Q3064473 wd:Q3300364 wd:Q3447475 wd:Q3706312 wd:Q3876358 wd:Q4310486 wd:Q4381410 wd:Q4436946 wd:Q4447304 wd:Q4809153 wd:Q6086970 wd:Q6087480 wd:Q6095524 wd:Q6096461 wd:Q6103622 wd:Q7034181 wd:Q8061940 wd:Q8082384 wd:Q12809521 wd:Q13045607 wd:Q13407931 wd:Q13420049 wd:Q14330482 wd:Q14551682 wd:Q14637461 wd:Q15620192 wd:Q15901932 wd:Q16017442 wd:Q17045723 wd:Q17045790 wd:Q17046466 wd:Q19610875 wd:Q19841238 wd:Q20470945 wd:Q20853404 wd:Q42281686 wd:Q48977782 wd:Q55437281 wd:Q56043430 wd:Q66133404 wd:Q69512938 wd:Q72219322 wd:Q107352615 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
