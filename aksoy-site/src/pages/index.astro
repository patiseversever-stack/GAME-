---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { site, waDefault } from '../data/site';
import { categories } from '../data/categories';
import { brands } from '../data/brands';
import { products } from '../data/products';
import { drawingSvg } from '../lib/drawings';
import { DRAWING_TO_MODEL } from '../scripts/three/models-map';
import '../styles/home.css';

const featured = products.filter((p) => p.featured).slice(0, 10);
// Kategori kartı görseli (3D açılamayan cihazlarda; açılınca canlı model gelir)
const CAT_RENDER: Record<string, string> = {
  insert: 'insert-C-n', 'holder-groove': 'holder-groove', 'thread-insert': 'thread-insert', endmill: 'endmill',
  'drill-u': 'drill-carbide', tap: 'tap-helis', 'chuck-bt': 'chuck-bt',
};
const codes = ['CNMG 120408', 'DNMG 150608', 'WNMG 080408', 'TNMG 160408', 'VNMG 160408', 'APMT 1604PDER', 'MGMN 300', 'SPMG 090408', 'CCMT 09T304', '16ER 1.5ISO', 'RPMT 10T3', 'SEKT 1204'];
const iso = [
  { g: 'P', t: 'Çelik', s: 'Yapı, ıslah, takım çeliği' },
  { g: 'M', t: 'Paslanmaz', s: 'Östenitik, dubleks' },
  { g: 'K', t: 'Dökme demir', s: 'Gri, sfero döküm' },
  { g: 'N', t: 'Demir dışı', s: 'Alüminyum, bakır, pirinç' },
  { g: 'S', t: 'Süper alaşım', s: 'Titanyum, Inconel' },
  { g: 'H', t: 'Sertleştirilmiş', s: '45–65 HRC çelik' },
];
---
<Base title={site.name} theme="dark" header="dark">
  <!-- ============ 3D VİTRİN ============ -->
  <section class="showcase" data-showcase aria-label="Uçlu U-matkap tanıtımı">
    <div class="showcase__sticky">
      <div class="showcase__bg"></div>
      <div class="showcase__grid"></div>
      <div class="showcase__num" aria-hidden="true"><span data-bignum>01</span></div>
      <div class="showcase__vignette" aria-hidden="true"></div>
      <picture>
        <source media="(max-width: 860px)" srcset="/img/udrill-poster-m.webp" width="780" height="1688" />
        <img class="showcase__poster" src="/img/udrill-poster.webp" alt="Uçlu U-matkap: koyu çelik gövde, düz talaş olukları ve iki adet altın renkli TiN kaplı karbür uç" width="1440" height="900" fetchpriority="high" decoding="async" data-poster />
      </picture>
      <canvas class="showcase__canvas" data-showcase-canvas aria-hidden="true"></canvas>
      <div class="callouts" data-callouts aria-hidden="true">
        <svg data-callout-svg></svg>
      </div>

      <article class="chapter" data-side="hero" data-chapter="0">
        <span class="eyebrow">{site.district} · {site.city}</span>
        <h1><span class="ln"><span>Doğru kesici takım,</span></span><span class="ln"><span><em class="tin" style="font-style:normal">aynı gün</em> teklif.</span></span></h1>
        <p>Torna ve freze uçları, karbür ve U-matkaplar, kılavuzlar ve takım tutucular tedarik ediyoruz. Kodu WhatsApp’tan yazın; fiyat, stok ve termin aynı gün gelsin.</p>
        <div class="chapter__actions">
          <a class="btn btn--tin" href="/urunler" data-magnetic><Icon name="grid" /> Kataloğu incele</a>
          <a class="btn btn--ghost" href={waDefault} target="_blank" rel="noopener" data-wa="hero"><Icon name="whatsapp" /> WhatsApp’tan teklif al</a>
        </div>
      </article>

      <article class="chapter" data-side="left" data-chapter="1">
        <span class="eyebrow">02 — Gövde</span>
        <h2><span class="ln"><span>Geniş oluklar</span></span><span class="ln"><span>talaşı dışarı atar.</span></span></h2>
        <p>U-matkap dolu malzemeyi ön delik açmadan tek seferde deler. Oluklar düz ve geniş olduğu için talaş delikte birikmez. 2xD’den 5xD’ye kadar boyları var.</p>
        <ul class="chapter__specs"><li>Ø 25 mm</li><li>4 × D</li><li>Weldon sap</li><li>İçten soğutma</li></ul>
      </article>

      <article class="chapter" data-side="right" data-chapter="2">
        <span class="eyebrow">03 — Uçlar</span>
        <h2><span class="ln"><span>Her uçta</span></span><span class="ln"><span>üç kesme kenarı var.</span></span></h2>
        <p>Merkez ve çevre ucu birer Torx vidayla bağlıdır. Kenar köreldiğinde matkabı bilemeye göndermezsiniz: vidayı gevşetin, ucu bir köşe çevirin, yeni kenarla devam edin.</p>
      </article>

      <article class="chapter" data-side="left" data-chapter="3">
        <span class="eyebrow">04 — Soğutma</span>
        <h2><span class="ln"><span>Soğutma sıvısı</span></span><span class="ln"><span>doğrudan uca gelir.</span></span></h2>
        <p>Sıvı, gövdenin içindeki kanallardan geçip kesme noktasına basınçla çıkar. Uç daha az ısınır, talaş oluktan kolay atılır, uç ömrü uzar.</p>
      </article>

      <article class="chapter" data-side="right" data-chapter="4">
        <span class="eyebrow">05 — Kaplama</span>
        <h2><span class="ln"><span>Kaplamayı</span></span><span class="ln"><span>malzemeniz belirler.</span></span></h2>
        <p>Kaydırdıkça kaplama değişir. TiN genel amaçlıdır. TiAlN ısıya ve sert malzemeye dayanır. TiCN aşınmaya karşı dayanıklıdır. Hangisinin size uyacağını malzemenize bakıp söyleriz.</p>
        <ul class="coat-chips" data-coat-chips>
          <li style="--c:#d9a441"><i></i>TiN</li>
          <li style="--c:#34373d"><i></i>TiAlN</li>
          <li style="--c:#7b6b86"><i></i>TiCN</li>
        </ul>
      </article>

      <article class="chapter" data-side="center" data-chapter="5">
        <span class="eyebrow">06 — Teklif</span>
        <h2><span class="ln"><span>Listenizi gönderin,</span></span><span class="ln"><span>fiyatı bugün alın.</span></span></h2>
        <p>Kodları ve adetleri teklif sepetine ekleyin, WhatsApp’tan tek mesajla gönderin. Fiyatı ve termini aynı gün bildiriyoruz. Ankara’dayız; İç Anadolu ve Ege’de atölyenize de geliyoruz.</p>
        <div class="chapter__actions">
          <a class="btn btn--tin" href="/urunler" data-magnetic><Icon name="grid" /> Kataloğu incele</a>
          <a class="btn btn--wa" href={waDefault} target="_blank" rel="noopener" data-wa="showcase-end"><Icon name="whatsapp" /> WhatsApp’tan teklif al</a>
        </div>
      </article>

      <div class="hud" aria-hidden="true">
        <span class="hud__name" data-hud-name>Giriş</span>
        <span class="hud__bar"><i data-hud-bar></i></span>
        <span class="hud__count"><b data-hud-n>01</b> / 06</span>
      </div>
      <div class="reel" data-reel role="group" aria-label="Tanıtım filmi kontrolü">
        <button class="reel__btn" type="button" data-reel-prev aria-label="Önceki sahne">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="reel__btn reel__play" type="button" data-reel-play aria-label="Filmi oynat" aria-pressed="false">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 5.5h3v13h-3zM13.5 5.5h3v13h-3z" fill="currentColor"/></svg>
        </button>
        <ol class="reel__track">
          {['Giriş', 'Gövde', 'Uçlar', 'Soğutma', 'Kaplama', 'Teklif'].map((c, i) => (
            <li><button type="button" data-reel-seg={i} aria-label={`${i + 1}. sahne: ${c}`}><i><b></b></i><span>{c}</span></button></li>
          ))}
        </ol>
        <button class="reel__next" type="button" data-reel-next aria-label="Sonraki sahne">
          <span data-reel-next-label>Sonraki sahne</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="showcase__side" aria-hidden="true">U-matkap · Ø25 · 4×D</div>
    </div>
  </section>

  <!-- ============ KOD BANDI ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => <span>{codes.map((c) => <span>{c}</span>)}</span>)}
    </div>
  </div>

  <!-- ============ ÜRÜN GRUPLARI ============ -->
  <section class="section section--dark" aria-labelledby="gruplar">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div style="display:grid;gap:18px;max-width:760px">
          <span class="eyebrow eyebrow--tin">Ürün grupları</span>
          <h2 id="gruplar" class="reveal">Tornalama, frezeleme, delme ve diş çekme için kesici takımlar.</h2>
        </div>
        <a class="link-arrow" href="/urunler">Tüm katalog <Icon name="arrow" /></a>
      </div>
      <div class="cats">
        {categories.map((c, i) => (
          <a class="cat reveal" href={`/kategori/${c.slug}`} style={`--d:${(i % 4) * 70}ms`} data-glow data-model={DRAWING_TO_MODEL[c.drawing]}>
            <span class="cat__num">{String(i + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}</span>
            {CAT_RENDER[c.drawing]
              ? <div class="cat__art cat__art--img"><img src={`/img/urun/${CAT_RENDER[c.drawing]}-s.webp`} alt="" width="600" height="450" loading="lazy" decoding="async" /></div>
              : <div class="cat__art" set:html={drawingSvg(c.drawing, c.shape)} />}
            <div>
              <h3>{c.name}</h3>
              <p>{c.summary}</p>
            </div>
            <span class="cat__go"><Icon name="arrow-up-right" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NASIL ÇALIŞIR ============ -->
  <section class="howto" aria-labelledby="nasil" data-howto>
    <div class="wrap">
      <header class="howto__head">
        <span class="eyebrow">Nasıl çalışıyoruz?</span>
        <h2 id="nasil" class="howto__title reveal">Üye olmadan, form doldurmadan teklif alın. <span>Kodu bulun, sepete ekleyin, WhatsApp’tan gönderin.</span></h2>
        <p class="howto__lead reveal" style="--d:100ms">Sitede satış yok, teklif var. Katalogdan kodu bulun ya da elinizdeki kutunun fotoğrafını gönderin; fiyatı ve termini aynı gün WhatsApp’tan yazalım.</p>
      </header>
      <ol class="howto__steps">
        <li class="hstep reveal" data-hstep="search">
          <div class="hstep__vis" aria-hidden="true">
            <div class="mock mock--search">
              <div class="mock__field">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" stroke-linecap="round" /></svg>
                <span class="mock__typed" data-typed>elmas uç</span><i class="mock__caret"></i>
              </div>
              <ul class="mock__list" data-results>
                <li class="is-hit"><b>CNMG 120408</b><span>Tornalama · P M K</span></li>
                <li><b>CNMG 120404</b><span>Finiş · P M</span></li>
                <li><b>DNMG 150608</b><span>Profil · P M</span></li>
              </ul>
            </div>
          </div>
          <div class="hstep__txt"><span class="hstep__n">01</span><h3>Kodu bulun</h3><p>CNMG, APMT, MGMN gibi bir kodla ya da “elmas uç”, “kılavuz” gibi bir kelimeyle arayın. İsterseniz malzemeye göre süzün.</p></div>
        </li>
        <li class="hstep reveal" style="--d:120ms" data-hstep="cart">
          <div class="hstep__vis" aria-hidden="true">
            <div class="mock mock--cart">
              <div class="mock__row"><img src="/img/urun/insert-C-n-s.webp" alt="" width="600" height="450" loading="lazy" decoding="async" /><div><b>CNMG 120408</b><small>Marka fark etmez</small></div><div class="mock__qty"><i>−</i><output data-qty="10">10</output><i>+</i></div></div>
              <div class="mock__row"><img src="/img/urun/insert-A-p-s.webp" alt="" width="600" height="450" loading="lazy" decoding="async" /><div><b>APMT 1604</b><small>Karbür · PVD</small></div><div class="mock__qty"><i>−</i><output data-qty="20">20</output><i>+</i></div></div>
              <div class="mock__note">Not: AISI 304 · CNC torna</div>
            </div>
          </div>
          <div class="hstep__txt"><span class="hstep__n">02</span><h3>Teklif sepetine ekleyin</h3><p>Adedi ve varsa marka tercihinizi seçin. İşlediğiniz malzemeyi ve tezgâhınızı not olarak yazın.</p></div>
        </li>
        <li class="hstep reveal" style="--d:240ms" data-hstep="chat">
          <div class="hstep__vis" aria-hidden="true">
            <div class="mock mock--chat">
              <div class="bubble bubble--out">Merhaba, teklif rica ediyorum:<br />CNMG 120408 × 10<br />APMT 1604 × 20<span class="bubble__t">10:42 <svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m1 5 3 3 6-7M8 8l1 0 6-7" /></svg></span></div>
              <div class="bubble bubble--in"><span class="bubble__dots"><i></i><i></i><i></i></span><span class="bubble__msg">İkisi de stokta, fiyatlar ekte. Onaylarsanız adrese getiriyoruz.<span class="bubble__t">10:51</span></span></div>
            </div>
          </div>
          <div class="hstep__txt"><span class="hstep__n">03</span><h3>WhatsApp’tan gönderin</h3><p>Liste tek mesaj olarak hazırlanır. Fiyat, stok ve terminle size dönüyoruz; onaylarsanız adrese getiriyor ya da kargoyla gönderiyoruz.</p></div>
        </li>
      </ol>
      <ul class="howto__facts">
        <li><b>Aynı gün</b><span>fiyat ve termin</span></li>
        <li><b>Üyelik yok</b><span>form yok, kart bilgisi yok</span></li>
        <li><b>Adrese teslim</b><span>ya da kargo</span></li>
      </ul>
    </div>
  </section>

  <!-- ============ MALZEME GRUPLARI ============ -->
  <section class="section section--tight section--paper" aria-labelledby="malzeme" style="padding-top:0">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div style="display:grid;gap:18px;max-width:760px">
          <span class="eyebrow">ISO 513 malzeme grupları</span>
          <h2 id="malzeme" class="reveal">Ne işliyorsunuz?</h2>
        </div>
        <p style="max-width:44ch;color:var(--ink-2)">Uç kutularındaki renkli P, M, K… harfleri bu grupları gösterir. Malzemenizi seçin, ona uygun uçları görün.</p>
      </div>
      <div class="isostrip">
        {iso.map((m) => (
          <a href={`/urunler?iso=${m.g}`} data-g={m.g}>
            <b>{m.g}</b>
            <span>{m.t}<small>{m.s}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ ÖNE ÇIKANLAR ============ -->
  {featured.length > 0 && (
    <section class="section section--paper" aria-labelledby="one-cikan" style="padding-top:0">
      <div class="wrap">
        <div class="section-head section-head--row">
          <div style="display:grid;gap:18px">
            <span class="eyebrow">En çok sorulanlar</span>
            <h2 id="one-cikan" class="reveal">Atölyelerin her gün kullandığı kodlar.</h2>
          </div>
          <a class="link-arrow" href="/urunler">Kataloğa git <Icon name="arrow" /></a>
        </div>
        <div class="hscroll">{featured.map((p) => <ProductCard p={p} />)}</div>
      </div>
    </section>
  )}

  <!-- ============ MİNİ HESAPLAYICI ============ -->
  <section class="section section--dark" aria-labelledby="hesap">
    <div class="wrap minicalc">
      <div class="section-head" style="margin:0">
        <span class="eyebrow eyebrow--tin">Teknik araçlar</span>
        <h2 id="hesap" class="reveal">Tezgâha yazacağınız devri hemen bulun.</h2>
        <p class="reveal" style="--d:100ms">Kesme hızını (Vc) ve çapı ayarlayın, devir anında hesaplansın. İlerleme hesabı, kılavuz matkap tablosu ve uç kodu çözücü teknik araçlar sayfasında.</p>
        <div><a class="btn btn--ghost" href="/teknik-araclar"><Icon name="calc" /> Tüm teknik araçlar</a></div>
      </div>
      <div class="minicalc__card reveal" data-minicalc>
        <div class="minicalc__row">
          <label for="mc-vc">Kesme hızı Vc <output data-out="vc">200 m/dk</output></label>
          <input id="mc-vc" type="range" min="20" max="600" step="5" value="200" data-in="vc" />
        </div>
        <div class="minicalc__row">
          <label for="mc-d">Çap D <output data-out="d">50 mm</output></label>
          <input id="mc-d" type="range" min="2" max="300" step="1" value="50" data-in="d" />
        </div>
        <div class="minicalc__result">
          <b data-out="n">1273</b>
          <span>devir / dakika<br />(n)</span>
        </div>
        <p class="minicalc__formula">n = (Vc × 1000) / (π × D)</p>
      </div>
    </div>
  </section>

  <!-- ============ MARKALAR ============ -->
  <section class="section section--ink" aria-labelledby="markalar">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow eyebrow--tin">Tedarik edilen markalar</span>
        <h2 id="markalar" class="reveal">Aynı kodun pahalısı da var, uygunu da.</h2>
        <p class="reveal" style="--d:100ms">Seri üretimde uzun ömürlü markayı, tek seferlik atölye işinde fiyatı uygun olanı öneriyoruz. İsterseniz ikisini yan yana fiyatlarız.</p>
      </div>
      <div class="brandlist">
        {brands.map((b) => (
          <a class="brandrow" href={`/markalar/${b.slug}`}>
            <span class="brandrow__name">{b.name}</span>
            <span class="brandrow__meta">{b.country ? `${b.country} · ` : ''}{b.segment}</span>
            <span class="brandrow__str">{b.strengths.slice(0, 3).join(' · ')}</span>
            <Icon name="arrow-up-right" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GÜVEN ============ -->
  <section class="section section--dark section--tight" aria-label="Neden Aksoy">
    <div class="wrap">
      <div class="trust">
        <div><Icon name="pin" /><b>Ostim / İvedik</b><p>Ankara’dayız. İç Anadolu ve Ege’de atölyenize gelip teslim ediyoruz.</p></div>
        <div><Icon name="bolt" /><b>Hızlı teklif</b><p>WhatsApp’tan liste gönderin; fiyat ve termin aynı gün.</p></div>
        <div><Icon name="shield" /><b>Orijinal ürün</b><p>Ürünler tedarikçi kanalından gelir, kendi kutusunda ve etiketiyle teslim edilir.</p></div>
        <div><Icon name="user" /><b>Ustadan ustaya</b><p>Malzemenize ve tezgâhınıza göre uç, kalite ve kesme değerleri öneriyoruz.</p></div>
      </div>
    </div>
  </section>

  <div class="preloader" data-preloader>
    <div class="pre__glow" aria-hidden="true"></div>
    <div class="pre__flare" aria-hidden="true"></div>
    <div class="pre__lock" aria-hidden="true">
      <svg class="pre__mark" viewBox="0 0 40 40">
        <defs>
          <linearGradient id="pre-g" x1="6" y1="3" x2="34" y2="37" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffe1a0" /><stop offset=".42" stop-color="#e2ac48" /><stop offset=".75" stop-color="#b9842c" /><stop offset="1" stop-color="#8a5f17" />
          </linearGradient>
          <linearGradient id="pre-sweep" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".85" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <clipPath id="pre-clip"><path d="M20 4 36.2 34.6H27.4L24.6 28.4H15.4L12.6 34.6H3.8Z" /></clipPath>
        </defs>
        <path class="pre__fill" fill="url(#pre-g)" stroke="url(#pre-g)" stroke-width="2.6" stroke-linejoin="round" fill-rule="evenodd" d="M20 4 36.2 34.6H27.4L24.6 28.4H15.4L12.6 34.6H3.8Z M20 13.8a3.5 3.5 0 1 0 .001 0Z" />
        <path class="pre__facet" d="M8.6 30.2 20 8.6 31.4 30.2" stroke="#5a3d0c" stroke-opacity=".3" stroke-width=".6" fill="none" />
        <g clip-path="url(#pre-clip)"><g class="pre__sweep"><rect x="-30" y="-5" width="14" height="50" fill="url(#pre-sweep)" transform="rotate(18 20 20)" /></g></g>
        <path class="pre__edge" d="M19.3 3.3 2.9 34.6" stroke="#fff4d6" stroke-width="1.1" stroke-linecap="round" />
        <path class="pre__line" pathLength="1" d="M20 4 36.2 34.6H27.4L24.6 28.4H15.4L12.6 34.6H3.8Z" fill="none" stroke="#e2ac48" stroke-width=".7" stroke-linejoin="round" />
      </svg>
      <div class="pre__type">
        <div class="pre__word">{'AKSOY'.split('').map((c, i) => <span style={`--i:${i}`}><b>{c}</b></span>)}</div>
        <div class="pre__sub"><i></i><span>KESİCİ TAKIMLAR</span><i></i></div>
      </div>
    </div>
    <p class="sr-only">Aksoy Kesici Takımlar yükleniyor</p>
    <div class="pre__foot">
      <span class="pre__meta">OSTİM · ANKARA</span>
      <button class="pre__sound" type="button" data-sound-toggle aria-pressed="false" data-on="Ses açık" data-off="Sesi aç">
