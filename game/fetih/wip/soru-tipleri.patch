+++ b/game/fetih/src/quiz/t_img.js
@@ -0,0 +1,279 @@
+// RESİMLİ SORU: blur (bulanıktan netleşir), zoom (çok yakından uzaklaşır), silhouette (siyah gölge),
+// rebus (birkaç resim yan yana, birleşimi bul).
+//
+// Veri: img: 'varlık_kimliği' | ['kimlik1','kimlik2',…] (rebus), mode, ve cevap için
+//       a: [doğru, y1, y2, y3]  (şıklı)  YA DA  w: 'KELİME' (klavyeyle yazılır).
+// Kimlikler assets.js manifestinden gelir; gerçek görsel yoksa prosedürel çizim kullanılır.
+//
+// Değer: şıklıda { i, f }, yazılıda { ok, tries, f }; f = cevap anındaki süre oranı (0..1).
+// Erken doğru cevap daha çok puan: judge → { correct, err (= f), score (100..40) }.
+// Tür 'exact': doğru olanlar arasında hızlı olan öne geçer (eşitlik bozma `time` ile).
+
+import { css, esc, shuffle, pCorrect, thinkTime, mountChoice, typedWord, clamp, trUp, chips, buzz } from './util.js';
+import { ASSETS, drawAsset, drawSilhouette, assetFocus, whenReady } from './assets.js';
+
+const CSS = /* css */ `
+.fl-img{display:flex;flex-direction:column;gap:10px}
+.fl-img-stage{position:relative;border-radius:18px;overflow:hidden;border:3px solid rgba(255,255,255,.85);box-shadow:0 6px 0 rgba(0,0,0,.35);background:#0d1630;line-height:0}
+.fl-img-stage canvas{display:block;width:100%;height:auto}
+.fl-img-rebus{display:flex;align-items:center;justify-content:center;gap:6px;padding:8px;border-radius:18px;background:rgba(0,0,0,.25);border:2px solid rgba(255,255,255,.14)}
+.fl-img-rebus .c{border-radius:14px;overflow:hidden;border:3px solid #fff;box-shadow:0 4px 0 rgba(0,0,0,.35);line-height:0;flex:none}
+.fl-img-rebus .c canvas{display:block}
+.fl-img-rebus .p{flex:none;font-family:'Lilita One';font-size:26px;color:var(--gold);text-shadow:0 2px 0 rgba(0,0,0,.4)}
+.fl-img-bonus{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.9}
+.fl-img-bonus i{flex:1;height:8px;border-radius:6px;background:rgba(255,255,255,.14);overflow:hidden;position:relative}
+.fl-img-bonus i::after{content:'';position:absolute;inset:0;border-radius:6px;background:linear-gradient(90deg,#ffd25a,#ff8a3a);transform-origin:0 50%;transform:scaleX(var(--k,1))}
+.fl-img-bonus b{font-family:'Lilita One';font-weight:400;font-size:15px;color:var(--gold);min-width:2.2em;text-align:right}
+.fl-img-cap{position:absolute;left:0;right:0;bottom:0;padding:8px 10px;text-align:center;font-family:'Lilita One';font-size:20px;line-height:1.1;color:#fff;
+  background:linear-gradient(180deg,transparent,rgba(10,16,34,.85));text-shadow:0 2px 0 rgba(0,0,0,.45);animation:flq-pop .35s cubic-bezier(.3,1.5,.5,1)}
+.fl-img-cap.rb{position:static;background:none;padding:4px;font-size:22px;color:#7dff9a}
+.fl-img-tag{position:absolute;left:8px;top:8px;padding:2px 9px;border-radius:999px;background:rgba(10,16,34,.75);font-size:11px;letter-spacing:.12em;text-transform:uppercase;line-height:1.5;border:1.5px solid rgba(255,255,255,.4)}
+`;
+
+const MODE_LABEL = { blur: 'Netleşen foto', zoom: 'Uzaklaşan foto', silhouette: 'Siluet', rebus: 'Resimli bulmaca' };
+const MODE_TAG = { blur: 'bulanık', zoom: 'yakın çekim', silhouette: 'gölge' };
+const LEVELS = [8, 11, 15, 21, 30, 44, 64, 96, 148, 230, 360, 480];
+const ease = (x) => 1 - Math.pow(1 - x, 2.2);
+
+export const img = {
+	time: 20,
+	label: 'Resimli soru',
+	kind: 'exact',
+	prepare(q, R) {
+		const ids = Array.isArray(q.img) ? q.img : [q.img];
+		const mode = q.mode || 'blur';
+		const v = { q, ids, mode, label: MODE_LABEL[mode] || 'Resimli soru' };
+		if (q.a) {
+			const order = shuffle([0, 1, 2, 3], R);
+			v.opts = order.map((i) => q.a[i]);
+			v.right = order.indexOf(0);
+		} else v.word = trUp(q.w);
+		return v;
+	},
+	mount(el, v, api) {
+		css('img', CSS);
+		const T = img.time;
+		const span = T * 0.85 * 1000; // bonus bu sürede erir
+		const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
+		const cssW = Math.min(el.clientWidth || 340, 380);
+		const typed = !!v.word;
+		const stageW = cssW;
+		const stageH = Math.round(stageW * (typed ? 0.5 : 0.62));
+		const multi = v.mode === 'rebus';
+		const bonus = v.mode === 'blur' || v.mode === 'zoom';
+		el.innerHTML = `<div class="fl-img">
+			${multi ? '<div class="fl-img-rebus"></div>' : '<div class="fl-img-stage"><canvas></canvas><span class="fl-img-tag">' + esc(MODE_TAG[v.mode] || '') + '</span></div>'}
+			${bonus ? '<div class="fl-img-bonus"><span>hız bonusu</span><i></i><b>100</b></div>' : ''}
+			<div data-r="ans"></div>
+		</div>`;
+		const root = el.querySelector('.fl-img');
+		const ansEl = el.querySelector('[data-r=ans]');
+		const bonusEl = el.querySelector('.fl-img-bonus');
+		const t0 = performance.now();
+		let done = false;
+		let alive = true;
+		const fNow = () => clamp((performance.now() - t0) / span, 0, 1);
+
+		// ------- tuvaller
+		let canvas = null;
+		let g = null;
+		const cw = Math.round(stageW * dpr);
+		const ch = Math.round(stageH * dpr);
+		const asp = ch / cw;
+		const mk = (w, h) => {
+			const c = document.createElement('canvas');
+			c.width = w;
+			c.height = h;
+			return c;
+		};
+		let rebusCanvases = [];
+		if (multi) {
+			const n = v.ids.length;
+			const rw = el.querySelector('.fl-img-rebus');
+			const cell = Math.floor((stageW - 16 - (n - 1) * 26) / n);
+			const px = Math.round(cell * dpr);
+			v.ids.forEach((id, i) => {
+				if (i) rw.insertAdjacentHTML('beforeend', '<span class="p">+</span>');
+				const d = document.createElement('div');
+				d.className = 'c';
+				const c = mk(px, px);
+				c.style.width = cell + 'px';
+				c.style.height = cell + 'px';
+				d.appendChild(c);
+				rw.appendChild(d);
+				rebusCanvases.push({ c, id });
+			});
+		} else {
+			canvas = el.querySelector('canvas');
+			canvas.width = cw;
+			canvas.height = ch;
+			g = canvas.getContext('2d');
+			g.imageSmoothingEnabled = true;
+		}
+		const id0 = v.ids[0];
+
+		// ------- kipler
+		const sil = mk(cw, ch);
+		let levels = null;
+		const buildLevels = () => {
+			const src = mk(480, Math.round(480 * asp));
+			drawAsset(src.getContext('2d'), id0, src.width, src.height, {});
+			levels = LEVELS.map((w) => {
+				const c = mk(w, Math.max(2, Math.round(w * asp)));
+				const x = c.getContext('2d');
+				x.imageSmoothingQuality = 'high';
+				x.drawImage(src, 0, 0, c.width, c.height);
+				return c;
+			});
+			// kademeli küçültme: büyük adımlarda tırtıklanmayı önler
+			for (let i = levels.length - 2; i >= 0; i--) {
+				const x = levels[i].getContext('2d');
+				x.imageSmoothingQuality = 'high';
+				x.clearRect(0, 0, levels[i].width, levels[i].height);
+				x.drawImage(levels[i + 1], 0, 0, levels[i].width, levels[i].height);
+			}
+		};
+		let lastKey = -1;
+		let curS = 16;
+		const focus = assetFocus(id0);
+		const draw = (f, final = false) => {
+			if (multi) {
+				for (const r of rebusCanvases) drawAsset(r.c.getContext('2d'), r.id, r.c.width, r.c.height, {});
+				return;
+			}
+			if (v.mode === 'blur') {
+				if (final) {
+					drawAsset(g, id0, cw, ch, {});
+					return;
+				}
+				if (!levels) buildLevels();
+				const p = clamp(f / 0.85, 0, 1);
+				const i = Math.min(LEVELS.length - 1, Math.floor(Math.pow(p, 0.75) * (LEVELS.length - 1) + 0.0001));
+				if (i === lastKey) return;
+				lastKey = i;
+				g.drawImage(levels[i], 0, 0, cw, ch);
+			} else if (v.mode === 'zoom') {
+				const s = final ? 1 : Math.exp(Math.log(16) * (1 - ease(clamp(f / 0.85, 0, 1))));
+				const key = Math.round(s * 40);
+				if (key === lastKey && !final) return;
+				lastKey = key;
+				curS = s;
+				drawAsset(g, id0, cw, ch, { view: { fx: focus[0], fy: focus[1], s } });
+			} else if (v.mode === 'silhouette') {
+				if (final) drawAsset(g, id0, cw, ch, {});
+				else if (lastKey < 0) {
+					lastKey = 1;
+					drawSilhouette(g, id0, cw, ch, sil);
+				}
+			}
+		};
+		const ready = whenReady(v.ids, () => {
+			lastKey = -1;
+			levels = null;
+			draw(fNow());
+		});
+		void ready;
+		draw(0);
+		// ------- döngü
+		const tick = () => {
+			if (!alive || !el.isConnected) return;
+			if (!done) {
+				const f = fNow();
+				draw(f);
+				if (bonusEl) {
+					const k = 1 - clamp(f / 1, 0, 1);
+					bonusEl.querySelector('i').style.setProperty('--k', k.toFixed(3));
+					bonusEl.querySelector('b').textContent = String(Math.round(40 + 60 * k));
+				}
+				requestAnimationFrame(tick);
+			}
+		};
+		requestAnimationFrame(tick);
+
+		// ------- cevap alanı
+		let ctl;
+		let tw = null;
+		let tries = 0;
+		if (typed) {
+			tw = typedWord(ansEl, v.word, {
+				onFull(guess) {
+					if (guess === v.word.replace(/ /g, '')) {
+						done = true;
+						tw.lock();
+						api.answer({ ok: true, tries, f: fNow() });
+					} else {
+						tries++;
+						tw.shake();
+						setTimeout(() => !done && tw.clear(), 380);
+					}
+				},
+			});
+		} else {
+			ctl = mountChoice(ansEl, v, api, { wrap: (i) => ({ i, f: fNow() }) });
+		}
+		return {
+			lock() {
+				done = true;
+				ctl?.lock();
+				tw?.lock();
+			},
+			value: () => null,
+			reveal(results) {
+				done = true;
+				alive = false;
+				const answerText = typed ? v.word : v.opts[v.right];
+				if (ctl) ctl.reveal(results, (x) => x?.i);
+				if (tw) tw.fill(v.word);
+				// resmi netle / renklendir
+				if (multi) {
+					draw(1);
+					root.insertAdjacentHTML('beforeend', `<div class="fl-img-cap rb">${esc(answerText)}</div>`);
+				} else {
+					const stage = el.querySelector('.fl-img-stage');
+					stage.querySelector('.fl-img-tag')?.remove();
+					if (v.mode === 'zoom') {
+						// kalan yakınlaştırmayı hızlıca aç
+						const a = performance.now();
+						const s0 = curS;
+						const step = (t) => {
+							const k = clamp((t - a) / 500, 0, 1);
+							drawAsset(g, id0, cw, ch, { view: { fx: focus[0], fy: focus[1], s: Math.exp(Math.log(s0) * (1 - ease(k))) } });
+							if (k < 1 && el.isConnected) requestAnimationFrame(step);
+						};
+						requestAnimationFrame(step);
+					} else draw(1, true);
+					stage.insertAdjacentHTML('beforeend', `<div class="fl-img-cap">${esc(answerText)}</div>`);
+				}
+				const mine = results;
+				root.insertAdjacentHTML('beforeend', chips(mine, (r) => (r.correct ? '✓ ' + Math.round(r.score ?? 0) : '✗')));
+			},
+			destroy() {
+				alive = false;
+			},
+		};
+	},
+	judge(v, value) {
+		if (!value) return { correct: false, err: 99, score: 0 };
+		const ok = v.word ? !!value.ok : value.i === v.right;
+		const f = clamp(value.f ?? 1, 0, 1);
+		return { correct: ok, err: ok ? f : 99, score: ok ? Math.round(100 - 60 * f) : 0 };
+	},
+	bot(v, skill, R) {
+		const time = thinkTime(R, 3, v.mode === 'rebus' ? 9 : 10);
+		const f = clamp(time / (img.time * 0.85), 0, 1);
+		let p = pCorrect(skill, v.q.diff);
+		if (v.mode === 'blur' || v.mode === 'zoom') p *= Math.min(1, 0.55 + f * 1.1);
+		if (v.word) p *= 0.85; // yazmak daha zor
+		const ok = R() < clamp(p, 0.05, 0.96);
+		let value;
+		if (v.word) value = { ok, tries: ok ? 0 : 2, f };
+		else {
+			let i = v.right;
+			if (!ok) do i = Math.floor(R() * 4); while (i === v.right);
+			value = { i, f };
+		}
+		return { value, time: v.word ? time + 3 : time };
+	},
+};
+
+export { ASSETS };
diff --git a/game/fetih/src/quiz/t_match.js b/game/fetih/src/quiz/t_match.js
new file mode 100644
index 0000000..c8961fe
--- /dev/null
+++ b/game/fetih/src/quiz/t_match.js
@@ -0,0 +1,196 @@
+// EŞLEŞTİR: sol sütundan bir öğeye, sonra sağ sütundan eşine dokun; renkli bir bağlantı çizgisi çizilir.
+// Veri: pairs: [[sol, sağ], ×4]
+// Değer (value): value[solIndeks] = ekrandaki sağ sıra numarası (-1: bağlanmamış)
+// Sıralama türü 'closest': err = yanlış ya da boş eşleşme sayısı (0..4).
+
+import { css, esc, shuffle, pCorrect, thinkTime, buzz, chips } from './util.js';
+
+const COLORS = ['#ffd25a', '#5ad1ff', '#ff7ab8', '#9dff7a'];
+
+const CSS = /* css */ `
+.fl-mat{position:relative;display:grid;grid-template-columns:1fr 54px 1fr;align-items:stretch}
+.fl-mat-col{display:flex;flex-direction:column;gap:8px;grid-row:1}
+.fl-mat-col.l{grid-column:1}.fl-mat-col.r{grid-column:3}
+.fl-mat-it{position:relative;min-height:54px;padding:6px 10px;border-radius:14px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:14.5px;line-height:1.15;
+  background:linear-gradient(180deg,#3a5ba8,#2a4486);border:2.5px solid rgba(255,255,255,.22);box-shadow:0 4px 0 #142554;touch-action:manipulation;
+  transition:transform .12s,border-color .2s,background .2s}
+.fl-mat-it:active{transform:translateY(2px)}
+.fl-mat-it.sel{border-color:#fff;background:linear-gradient(180deg,#6a7fc8,#4a5fa8);transform:scale(1.04)}
+.fl-mat-it.on{border-color:var(--c)}
+.fl-mat-it.on::after{content:'';position:absolute;top:50%;width:12px;height:12px;margin-top:-6px;border-radius:50%;background:var(--c);border:2px solid #fff}
+.fl-mat-col.l .fl-mat-it.on::after{right:-8px}
+.fl-mat-col.r .fl-mat-it.on::after{left:-8px}
+.fl-mat-it.ok{background:linear-gradient(180deg,#4fd16a,#2a9a44);border-color:#fff;box-shadow:0 4px 0 #156a2a}
+.fl-mat-it.bad{background:linear-gradient(180deg,#ff6a5a,#c8352a);box-shadow:0 4px 0 #7a1a12}
+.fl-mat svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
+.fl-mat path{fill:none;stroke-width:5;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .3s ease-out,opacity .3s}
+.fl-mat path.in{stroke-dashoffset:0}
+.fl-mat path.out{opacity:0}
+.fl-mat-send{margin-top:10px;width:100%}
+.fl-mat.sent .fl-mat-send{display:none}
+`;
+
+export const match = {
+	time: 25,
+	label: 'Eşleştir',
+	kind: 'closest',
+	prepare(q, R) {
+		const n = q.pairs.length;
+		const idx = q.pairs.map((_, i) => i);
+		let ord = shuffle(idx, R);
+		for (let k = 0; k < 12 && ord.every((x, i) => x === i); k++) ord = shuffle(idx, R);
+		// ord[j]: j. sağ konumda gösterilen çiftin indeksi
+		return { q, n, ord, left: q.pairs.map((p) => p[0]), right: ord.map((i) => q.pairs[i][1]) };
+	},
+	mount(el, v, api) {
+		css('match', CSS);
+		const n = v.n;
+		el.innerHTML = `<div class="fl-mat">
+			<svg></svg>
+			<div class="fl-mat-col l">${v.left.map((t, i) => `<button class="fl-mat-it" data-s="l" data-i="${i}">${esc(t)}</button>`).join('')}</div>
+			<div class="fl-mat-col r">${v.right.map((t, i) => `<button class="fl-mat-it" data-s="r" data-i="${i}">${esc(t)}</button>`).join('')}</div>
+		</div>
+		<button class="fl-send fl-mat-send" disabled>ONAYLA</button>`;
+		const root = el.querySelector('.fl-mat');
+		const svg = root.querySelector('svg');
+		const L = [...root.querySelectorAll('.l .fl-mat-it')];
+		const Rt = [...root.querySelectorAll('.r .fl-mat-it')];
+		const send = el.querySelector('.fl-mat-send');
+		const m = Array(n).fill(-1); // sol → sağ
+		let sel = null;
+		let done = false;
+		const paths = new Map();
+
+		const anchor = (b, side) => ({ x: side === 'l' ? b.offsetLeft + b.offsetWidth : b.offsetLeft, y: b.offsetTop + b.offsetHeight / 2 });
+		const makePath = (l, r, color, cls = '') => {
+			const a = anchor(L[l], 'l');
+			const b = anchor(Rt[r], 'r');
+			const dx = (b.x - a.x) * 0.55;
+			const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
+			p.setAttribute('d', `M${a.x},${a.y} C${a.x + dx},${a.y} ${b.x - dx},${b.y} ${b.x},${b.y}`);
+			p.setAttribute('pathLength', '1');
+			p.style.stroke = color;
+			if (cls) p.classList.add(cls);
+			svg.appendChild(p);
+			requestAnimationFrame(() => requestAnimationFrame(() => p.classList.add('in')));
+			return p;
+		};
+		const clearSel = () => {
+			sel = null;
+			for (const b of [...L, ...Rt]) b.classList.remove('sel');
+		};
+		const paint = () => {
+			L.forEach((b, i) => {
+				b.classList.toggle('on', m[i] >= 0);
+				b.style.setProperty('--c', COLORS[i]);
+			});
+			Rt.forEach((b, j) => {
+				const l = m.indexOf(j);
+				b.classList.toggle('on', l >= 0);
+				if (l >= 0) b.style.setProperty('--c', COLORS[l]);
+			});
+			send.disabled = m.some((x) => x < 0);
+		};
+		const drop = (l) => {
+			if (m[l] < 0) return;
+			const p = paths.get(l);
+			if (p) {
+				p.classList.add('out');
+				setTimeout(() => p.remove(), 300);
+				paths.delete(l);
+			}
+			m[l] = -1;
+		};
+		const connect = (l, r) => {
+			drop(l);
+			const prev = m.indexOf(r);
+			if (prev >= 0) drop(prev);
+			m[l] = r;
+			paths.set(l, makePath(l, r, COLORS[l]));
+			buzz(10);
+		};
+		const tap = (side, i) => {
+			if (done) return;
+			if (sel && sel.side !== side) {
+				const l = side === 'l' ? i : sel.i;
+				const r = side === 'l' ? sel.i : i;
+				clearSel();
+				connect(l, r);
+			} else {
+				// aynı sütun: bağlıysa çözüp yeniden seç
+				if (side === 'l') drop(i);
+				else {
+					const l = m.indexOf(i);
+					if (l >= 0) drop(l);
+				}
+				clearSel();
+				sel = { side, i };
+				(side === 'l' ? L : Rt)[i].classList.add('sel');
+			}
+			paint();
+		};
+		root.addEventListener('click', (e) => {
+			const b = e.target.closest('.fl-mat-it');
+			if (b) tap(b.dataset.s, Number(b.dataset.i));
+		});
+		send.addEventListener('click', () => {
+			if (done || send.disabled) return;
+			done = true;
+			clearSel();
+			root.classList.add('sent');
+			api.answer(m.slice());
+		});
+		paint();
+		return {
+			lock() {
+				done = true;
+			},
+			value: () => m.slice(),
+			reveal(results) {
+				done = true;
+				root.classList.add('sent');
+				clearSel();
+				for (const p of paths.values()) p.classList.add('out');
+				const okL = [];
+				L.forEach((b, l) => {
+					const good = m[l] >= 0 && v.ord[m[l]] === l;
+					okL.push(good);
+					b.classList.remove('on');
+					b.classList.add(good ? 'ok' : 'bad');
+				});
+				Rt.forEach((b, j) => {
+					const l = m.indexOf(j);
+					b.classList.remove('on');
+					b.classList.add(l >= 0 && v.ord[j] === l ? 'ok' : 'bad');
+				});
+				// doğru çizgiler sırayla belirir
+				setTimeout(() => {
+					svg.innerHTML = '';
+					for (const p of paths.values()) p.remove();
+					L.forEach((b, l) => setTimeout(() => makePath(l, v.ord.indexOf(l), '#7dff9a'), l * 140));
+					L.concat(Rt).forEach((b) => b.classList.remove('bad'));
+					L.concat(Rt).forEach((b) => b.classList.add('ok'));
+				}, 700);
+				root.insertAdjacentHTML('afterend', chips(results, (r) => (r.err === 0 ? '✓' : r.value ? 4 - r.err + '/4' : '—')));
+			},
+			destroy() {},
+		};
+	},
+	judge(v, value) {
+		if (!Array.isArray(value)) return { correct: false, err: v.n };
+		let err = 0;
+		for (let l = 0; l < v.n; l++) if (value[l] == null || value[l] < 0 || v.ord[value[l]] !== l) err++;
+		return { correct: err === 0, err };
+	},
+	bot(v, skill, R) {
+		// doğru eşleşmeyi bul; bilmeyen bot en az iki öğeyi karıştırır
+		const m = v.ord.map((_, j) => j).map((j) => v.ord.indexOf(j)); // sol l → sağ konum
+		if (R() >= Math.min(0.96, pCorrect(skill, v.q.diff) + 0.08)) {
+			const k = 2 + (R() < 0.35 ? 1 : 0) + (R() < 0.15 ? 1 : 0);
+			const picks = shuffle([...m.keys()], R).slice(0, Math.min(k, v.n));
+			const vals = picks.map((l) => m[l]);
+			picks.forEach((l, i) => (m[l] = vals[(i + 1) % picks.length]));
+		}
+		return { value: m, time: thinkTime(R, 7, 9) };
+	},
+};
diff --git a/game/fetih/src/quiz/t_order.js b/game/fetih/src/quiz/t_order.js
new file mode 100644
index 0000000..1c723db
--- /dev/null
+++ b/game/fetih/src/quiz/t_order.js
@@ -0,0 +1,188 @@
+// SIRALA (kronoloji): 4 öğeyi sürükleyerek küçükten büyüğe (ya da eskiden yeniye) diz.
+// Veri: items: [{t, v, s?}, ×4]  (t metin, v sıralama değeri, s isteğe bağlı gösterim metni)
+//       lo / hi: isteğe bağlı uç etiketleri ("en eski" / "en yeni").
+// Değer (value): öğe indekslerinin sırası, örn. [2,0,3,1]
+// Sıralama türü 'closest': err = ters çevrilmiş çift sayısı (0..6); 0 = tam doğru.
+
+import { css, esc, shuffle, pCorrect, gauss, thinkTime, clamp, buzz, chips, fmtNum } from './util.js';
+
+const PITCH = 60;
+const ROW = 52;
+
+const CSS = /* css */ `
+.fl-ord{display:flex;flex-direction:column;gap:6px}
+.fl-ord-cap{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.65;text-align:center}
+.fl-ord-list{position:relative;touch-action:none}
+.fl-ord-row{position:absolute;left:0;right:0;top:0;height:${ROW}px;display:flex;align-items:center;gap:10px;padding:0 12px 0 8px;border-radius:14px;
+  background:linear-gradient(180deg,#3a5ba8,#2a4486);border:2px solid rgba(255,255,255,.22);box-shadow:0 4px 0 #142554;
+  transition:transform .22s cubic-bezier(.3,1.3,.5,1),background .25s,border-color .25s,box-shadow .25s;touch-action:none;cursor:grab;will-change:transform}
+.fl-ord-row.drag{transition:none;z-index:5;border-color:#fff;box-shadow:0 10px 18px rgba(0,0,0,.45);cursor:grabbing;background:linear-gradient(180deg,#5f7fd2,#3f5fb2)}
+.fl-ord-row.sel{border-color:var(--gold);box-shadow:0 0 0 3px rgba(255,210,90,.35),0 4px 0 #142554}
+.fl-ord-row b{flex:none;width:28px;height:28px;border-radius:9px;background:rgba(255,255,255,.2);display:grid;place-items:center;font-family:'Lilita One';font-weight:400;font-size:16px}
+.fl-ord-row span{flex:1;min-width:0;font-size:16px;line-height:1.15}
+.fl-ord-row em{font-style:normal;font-family:'Lilita One';font-size:16px;color:var(--gold);opacity:0;transition:opacity .3s}
+.fl-ord-row .fl-grip{flex:none;width:16px;height:16px;background:radial-gradient(circle,rgba(255,255,255,.55) 1.6px,transparent 2px) 0 0/8px 8px;opacity:.8}
+.fl-ord-row.ok{background:linear-gradient(180deg,#4fd16a,#2a9a44);box-shadow:0 4px 0 #156a2a;border-color:#fff}
+.fl-ord-row.bad{background:linear-gradient(180deg,#ff6a5a,#c8352a);box-shadow:0 4px 0 #7a1a12}
+.fl-ord-row.fin{background:linear-gradient(180deg,#4fd16a,#2a9a44);box-shadow:0 4px 0 #156a2a;border-color:#fff}
+.fl-ord-row.ok em,.fl-ord-row.bad em,.fl-ord-row.fin em{opacity:1;color:#fff}
+.fl-ord .fl-send{margin-top:4px}
+.fl-ord.sent .fl-send{display:none}
+.fl-ord.sent .fl-grip{display:none}
+`;
+
+/** values: item indeksleri sırası; ters çevrilmiş çift sayısı. */
+export function inversions(seq, items) {
+	let c = 0;
+	for (let i = 0; i < seq.length; i++) for (let j = i + 1; j < seq.length; j++) if (items[seq[i]].v > items[seq[j]].v) c++;
+	return c;
+}
+
+export const order = {
+	time: 25,
+	label: 'Sırala',
+	kind: 'closest',
+	prepare(q, R) {
+		const idx = q.items.map((_, i) => i);
+		const correct = idx.slice().sort((a, b) => q.items[a].v - q.items[b].v);
+		let start = shuffle(idx, R);
+		for (let k = 0; k < 12 && inversions(start, q.items) === 0; k++) start = shuffle(idx, R);
+		return { q, start, correct };
+	},
+	mount(el, v, api) {
+		css('order', CSS);
+		const items = v.q.items;
+		const n = items.length;
+		let seq = v.start.slice();
+		el.innerHTML = `<div class="fl-ord">
+			<div class="fl-ord-cap">▲ ${esc(v.q.lo || 'en küçük')}</div>
+			<div class="fl-ord-list" style="height:${n * PITCH - (PITCH - ROW)}px">${items
+				.map((it, i) => `<div class="fl-ord-row" data-i="${i}"><b></b><span>${esc(it.t)}</span><em></em><i class="fl-grip"></i></div>`)
+				.join('')}</div>
+			<div class="fl-ord-cap">▼ ${esc(v.q.hi || 'en büyük')}</div>
+			<button class="fl-send">ONAYLA</button>
+		</div>`;
+		const root = el.querySelector('.fl-ord');
+		const list = el.querySelector('.fl-ord-list');
+		const rows = [...el.querySelectorAll('.fl-ord-row')];
+		let done = false;
+		let drag = null;
+		let sel = -1;
+		const place = (skip = -1) => {
+			seq.forEach((k, slot) => {
+				if (k === skip) return;
+				rows[k].style.transform = `translateY(${slot * PITCH}px)`;
+				rows[k].firstChild.textContent = slot + 1;
+			});
+			if (skip >= 0) rows[skip].firstChild.textContent = seq.indexOf(skip) + 1;
+		};
+		place();
+		list.addEventListener('pointerdown', (e) => {
+			if (done || drag) return;
+			const row = e.target.closest('.fl-ord-row');
+			if (!row) return;
+			const i = Number(row.dataset.i);
+			drag = { row, i, y0: e.clientY, base: seq.indexOf(i) * PITCH, moved: false, id: e.pointerId };
+			try {
+				row.setPointerCapture(e.pointerId);
+			} catch {
+				/* yoksay */
+			}
+		});
+		list.addEventListener('pointermove', (e) => {
+			if (!drag || e.pointerId !== drag.id) return;
+			const dy = e.clientY - drag.y0;
+			if (!drag.moved) {
+				if (Math.abs(dy) < 6) return;
+				drag.moved = true;
+				drag.row.classList.add('drag');
+				rows.forEach((r) => r.classList.remove('sel'));
+				sel = -1;
+			}
+			const y = clamp(drag.base + dy, -6, (n - 1) * PITCH + 6);
+			drag.row.style.transform = `translateY(${y}px) scale(1.03)`;
+			const slot = clamp(Math.round(y / PITCH), 0, n - 1);
+			const cur = seq.indexOf(drag.i);
+			if (slot !== cur) {
+				seq.splice(cur, 1);
+				seq.splice(slot, 0, drag.i);
+				place(drag.i);
+				buzz(6);
+			}
+		});
+		const end = (e) => {
+			if (!drag || e.pointerId !== drag.id) return;
+			const d = drag;
+			drag = null;
+			d.row.classList.remove('drag');
+			if (d.moved) return place();
+			// dokunma: ilk dokunuş seçer, ikincisi yer değiştirir
+			if (sel < 0) {
+				sel = d.i;
+				d.row.classList.add('sel');
+			} else if (sel === d.i) {
+				sel = -1;
+				d.row.classList.remove('sel');
+			} else {
+				const a = seq.indexOf(sel);
+				const b = seq.indexOf(d.i);
+				[seq[a], seq[b]] = [seq[b], seq[a]];
+				rows[sel].classList.remove('sel');
+				sel = -1;
+				place();
+				buzz(8);
+			}
+		};
+		list.addEventListener('pointerup', end);
+		list.addEventListener('pointercancel', end);
+		el.querySelector('.fl-send').addEventListener('click', () => {
+			if (done) return;
+			done = true;
+			root.classList.add('sent');
+			api.answer(seq.slice());
+		});
+		return {
+			lock() {
+				done = true;
+				drag = null;
+			},
+			value: () => seq.slice(),
+			reveal(results) {
+				done = true;
+				root.classList.add('sent');
+				rows.forEach((r) => r.classList.remove('sel', 'drag'));
+				const right = v.correct;
+				const unit = v.q.unit ? ' ' + v.q.unit : '';
+				rows.forEach((r, i) => {
+					r.classList.add(seq.indexOf(i) === right.indexOf(i) ? 'ok' : 'bad');
+					r.querySelector('em').textContent = (items[i].s ?? fmtNum(items[i].v)) + (items[i].s ? '' : unit);
+				});
+				setTimeout(() => {
+					seq = right.slice();
+					rows.forEach((r) => r.classList.add('fin'));
+					place();
+				}, 750);
+				root.insertAdjacentHTML('beforeend', chips(results, (r) => (r.err === 0 ? '✓' : r.value ? r.err + ' hata' : '—')));
+			},
+			destroy() {},
+		};
+	},
+	judge(v, value) {
+		const max = (v.q.items.length * (v.q.items.length - 1)) / 2;
+		if (!Array.isArray(value)) return { correct: false, err: max };
+		const err = inversions(value, v.q.items);
+		return { correct: err === 0, err };
+	},
+	bot(v, skill, R) {
+		const seq = v.correct.slice();
+		if (R() >= Math.min(0.97, pCorrect(skill, v.q.diff) + 0.05)) {
+			// komşu yer değiştirmeleriyle yanılgı (1..3)
+			const k = clamp(Math.round(Math.abs(gauss(R)) * (1.5 - skill) * 1.4) + 1, 1, 4);
+			for (let j = 0; j < k; j++) {
+				const a = Math.floor(R() * (seq.length - 1));
+				[seq[a], seq[a + 1]] = [seq[a + 1], seq[a]];
+			}
+		}
+		return { value: seq, time: thinkTime(R, 6, 10) };
+	},
+};
diff --git a/game/fetih/src/quiz/t_pick.js b/game/fetih/src/quiz/t_pick.js
new file mode 100644
index 0000000..b98d8d7
--- /dev/null
+++ b/game/fetih/src/quiz/t_pick.js
@@ -0,0 +1,234 @@
+// Seçmeli tipler: hilo, odd, emoji, proverb, riddle.
+// Hepsi 'exact' türünde: bildi / bilemedi; eşitlikte hızlı olan kazanır.
+
+import { css, esc, shuffle, pCorrect, thinkTime, mountChoice, buzz, fmtNum, clamp } from './util.js';
+
+const CSS = /* css */ `
+/* hilo */
+.fl-hilo{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:relative}
+.fl-hl{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:150px;padding:12px 8px;border-radius:18px;text-align:center;
+  border:2.5px solid rgba(255,255,255,.3);box-shadow:0 6px 0 rgba(0,0,0,.35);touch-action:manipulation;transition:transform .15s,opacity .3s,filter .3s}
+.fl-hl.a{background:linear-gradient(160deg,#4a7be0,#2a4aa8)}
+.fl-hl.b{background:linear-gradient(160deg,#f08a3a,#c8501a)}
+.fl-hl:active{transform:translateY(3px)}
+.fl-hl strong{font-family:'Lilita One';font-weight:400;font-size:clamp(20px,6vw,27px);line-height:1.05;text-wrap:balance;text-shadow:0 2px 0 rgba(0,0,0,.35)}
+.fl-hl small{font-size:12px;letter-spacing:.1em;text-transform:uppercase;opacity:.8}
+.fl-hl .val{font-family:'Lilita One';font-size:30px;min-height:36px;color:var(--gold);text-shadow:0 2px 0 rgba(0,0,0,.4);opacity:0;transform:scale(.6);transition:opacity .25s,transform .35s cubic-bezier(.3,1.6,.5,1)}
+.fl-hl .val u{display:block;text-decoration:none;font-family:'Fredoka';font-size:12px;color:#fff;opacity:.85}
+.fl-hl.show .val{opacity:1;transform:scale(1)}
+.fl-hl.pick{outline:3px solid #fff;outline-offset:2px;transform:scale(1.03)}
+.fl-hl.right{border-color:#7dff9a;box-shadow:0 0 0 3px rgba(125,255,154,.45),0 6px 0 rgba(0,0,0,.35)}
+.fl-hl.right::before{content:'♛';position:absolute;top:-16px;left:50%;transform:translateX(-50%);font-size:26px;color:var(--gold);text-shadow:0 2px 0 #6a3a00}
+.fl-hl.lose{opacity:.55;filter:saturate(.6)}
+.fl-hilo i.vs{position:absolute;left:50%;top:50%;width:38px;height:38px;margin:-19px 0 0 -19px;border-radius:50%;display:grid;place-items:center;font-style:normal;
+  font-family:'Lilita One';font-size:15px;background:#101a33;border:2.5px solid var(--gold);color:var(--gold);z-index:2}
+/* odd */
+.fl-odd .fl-opt{min-height:64px;justify-content:center;text-align:center;font-size:17px}
+.fl-odd .fl-opt i{position:absolute;top:5px;left:5px;width:20px;height:20px;font-size:12px}
+.fl-why{margin-top:10px;padding:9px 12px;border-radius:12px;background:rgba(255,210,90,.16);border:1.5px solid var(--line);font-size:14.5px;line-height:1.3;text-align:center;
+  animation:flq-pop .35s cubic-bezier(.3,1.5,.5,1)}
+.fl-why b{color:var(--gold)}
+/* emoji */
+.fl-emo{display:flex;justify-content:center;flex-wrap:wrap;gap:2px 6px;margin:0 0 12px;padding:10px 6px;border-radius:18px;background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.18),rgba(255,255,255,.04));
+  border:2px solid rgba(255,255,255,.14)}
+.fl-emo span{font-size:clamp(42px,13vw,60px);line-height:1.15;font-family:'Noto Color Emoji','Apple Color Emoji','Segoe UI Emoji',sans-serif;opacity:0;animation:flq-bounce .55s cubic-bezier(.3,1.7,.5,1) forwards}
+/* proverb */
+.fl-prv{margin:0 0 12px;padding:14px 12px;border-radius:18px;background:linear-gradient(180deg,rgba(255,235,190,.22),rgba(255,235,190,.1));border:2px solid rgba(255,210,90,.4);
+  text-align:center;font-size:clamp(19px,5.4vw,24px);line-height:1.5;text-wrap:balance}
+.fl-prv::before{content:'❝';display:block;font-size:26px;line-height:.8;color:var(--gold);opacity:.8}
+.fl-blank{display:inline-block;min-width:4.2em;padding:0 8px;margin:0 2px;border-radius:9px;background:rgba(0,0,0,.28);border-bottom:3px solid var(--gold);color:var(--gold);
+  font-family:'Lilita One';animation:flq-pulse 1.1s ease-in-out infinite}
+.fl-blank.set{animation:none;border-color:#fff;color:#fff}
+.fl-blank.right{background:#2a9a44;border-color:#fff;color:#fff}
+.fl-blank.wrong{background:#c8352a;border-color:#fff;color:#fff}
+/* bilmece */
+.fl-rid{display:flex;justify-content:center;margin:-2px 0 8px;font-size:34px;filter:drop-shadow(0 3px 0 rgba(0,0,0,.35))}
+.fl-rid span{display:inline-block;animation:flq-float 2.2s ease-in-out infinite}
+@keyframes flq-bounce{0%{transform:translateY(24px) scale(.3);opacity:0}100%{transform:none;opacity:1}}
+@keyframes flq-pulse{50%{box-shadow:0 0 0 4px rgba(255,210,90,.35)}}
+@keyframes flq-float{50%{transform:translateY(-4px) rotate(4deg)}}
+`;
+
+const choiceKind = (extra) => ({
+	kind: 'exact',
+	judge(v, value) {
+		return { correct: value === v.right, err: value === v.right ? 0 : 1 };
+	},
+	...extra,
+});
+
+/** 4 şıklı tipler için ortak bot. */
+function choiceBot(v, skill, R, [base, span] = [3, 6], bonus = 0) {
+	const ok = R() < Math.min(0.96, pCorrect(skill, v.q.diff) + bonus);
+	let value = v.right;
+	if (!ok) do value = Math.floor(R() * v.opts.length); while (value === v.right);
+	return { value, time: thinkTime(R, base, span) };
+}
+
+/** a: [doğru, y1, y2, y3] → karıştırılmış şıklar */
+function prepChoice(q, R, extra = {}) {
+	const order = shuffle([0, 1, 2, 3], R);
+	return { q, opts: order.map((i) => q.a[i]), right: order.indexOf(0), ...extra };
+}
+
+// ---------------------------------------------------------------- hilo
+export const hilo = {
+	time: 10,
+	label: 'Hangisi daha fazla?',
+	prepare(q, R) {
+		const flip = R() < 0.5; // doğru taraf rastgele zaten veride; ekranda yerlerini de karıştır
+		const sides = flip ? [q.right, q.left] : [q.left, q.right];
+		return { q, sides, right: sides[0].v > sides[1].v ? 0 : 1 };
+	},
+	mount(el, v, api) {
+		css('pick', CSS);
+		const unit = v.q.unit || '';
+		el.innerHTML = `<div class="fl-hilo">${v.sides
+			.map((s, i) => `<button class="fl-hl ${'ab'[i]}" data-i="${i}"><strong>${esc(s.t)}</strong><small>${esc(v.q.prop || '')}</small><div class="val">?</div></button>`)
+			.join('')}<i class="vs">VS</i></div>`;
+		const btns = [...el.querySelectorAll('.fl-hl')];
+		let done = false;
+		for (const b of btns)
+			b.addEventListener('click', () => {
+				if (done) return;
+				done = true;
+				b.classList.add('pick');
+				buzz();
+				api.answer(Number(b.dataset.i));
+			});
+		const countUp = (node, to, dur = 900) => {
+			const t0 = performance.now();
+			const step = (t) => {
+				if (!node.isConnected) return;
+				const k = Math.min(1, (t - t0) / dur);
+				const e = 1 - Math.pow(1 - k, 3);
+				const x = Number.isInteger(to) ? Math.round(to * e) : to * e;
+				node.firstChild.nodeValue = fmtNum(k < 1 ? x : to);
+				if (k < 1) requestAnimationFrame(step);
+			};
+			requestAnimationFrame(step);
+		};
+		return {
+			lock() {
+				done = true;
+			},
+			reveal(results) {
+				done = true;
+				btns.forEach((b, i) => {
+					const val = b.querySelector('.val');
+					val.innerHTML = `0<u>${esc(unit)}</u>`;
+					b.classList.add('show', i === v.right ? 'right' : 'lose');
+					countUp(val, v.sides[i].v);
+				});
+				for (const r of results) if (r.value != null) btns[r.value]?.insertAdjacentHTML('beforeend', `<b class="fl-who" style="background:${r.color}"></b>`);
+			},
+			destroy() {},
+		};
+	},
+	...choiceKind({
+		bot(v, skill, R) {
+			// değerler birbirine yakınsa bot da şaşırır
+			const a = v.sides[0].v;
+			const b = v.sides[1].v;
+			const ratio = Math.max(a, b) / Math.max(1e-9, Math.min(a, b));
+			const close = clamp((1.6 - ratio) * 0.35, 0, 0.3);
+			const ok = R() < clamp(pCorrect(skill, v.q.diff) + 0.12 - close, 0.3, 0.96);
+			return { value: ok ? v.right : 1 - v.right, time: thinkTime(R, 1.8, 4) };
+		},
+	}),
+};
+
+// ---------------------------------------------------------------- odd
+export const odd = {
+	time: 15,
+	label: 'Farklı olanı bul',
+	prepare(q, R) {
+		const ord = shuffle([0, 1, 2, 3], R);
+		return { q, opts: ord.map((i) => q.opts[i]), right: ord.indexOf(q.odd) };
+	},
+	mount(el, v, api) {
+		css('pick', CSS);
+		el.innerHTML = '<div class="fl-odd"></div><div data-r="why"></div>';
+		const box = el.querySelector('.fl-odd');
+		const ctl = mountChoice(box, v, api);
+		return {
+			lock: ctl.lock,
+			reveal(results) {
+				ctl.reveal(results);
+				ctl.btns.forEach((b, i) => i !== v.right && !b.classList.contains('wrong') && b.classList.add('dim'));
+				if (v.q.why) el.querySelector('[data-r=why]').innerHTML = `<div class="fl-why"><b>${esc(v.opts[v.right])}</b> farklı: ${esc(v.q.why)}</div>`;
+			},
+			destroy() {},
+		};
+	},
+	...choiceKind({ bot: (v, s, R) => choiceBot(v, s, R, [3, 6]) }),
+};
+
+// ---------------------------------------------------------------- emoji
+export const emoji = {
+	time: 15,
+	label: 'Emoji bilmecesi',
+	prepare: (q, R) => prepChoice(q, R),
+	mount(el, v, api) {
+		css('pick', CSS);
+		// her emoji ayrı bir kutu (bayrak/ZWJ dizileri ve renk tonları tek parça)
+		const parts = v.q.e.match(/\p{Extended_Pictographic}(?:️|‍\p{Extended_Pictographic}️?|[\u{1F3FB}-\u{1F3FF}])*|\S/gu) || [];
+		el.innerHTML = `<div class="fl-emo">${parts.map((e, i) => `<span style="animation-delay:${0.08 + i * 0.12}s">${e}</span>`).join('')}</div><div data-r="o"></div>`;
+		const ctl = mountChoice(el.querySelector('[data-r=o]'), v, api);
+		return { lock: ctl.lock, reveal: (r) => ctl.reveal(r), destroy() {} };
+	},
+	...choiceKind({ bot: (v, s, R) => choiceBot(v, s, R, [2.5, 6]) }),
+};
+
+// ---------------------------------------------------------------- proverb
+export const proverb = {
+	time: 15,
+	label: 'Atasözünü tamamla',
+	prepare: (q, R) => prepChoice(q, R),
+	mount(el, v, api) {
+		css('pick', CSS);
+		const [pre, post] = v.q.text.split('___');
+		el.innerHTML = `<div class="fl-prv">${esc(pre)}<span class="fl-blank">&nbsp;?&nbsp;</span>${esc(post || '')}</div><div data-r="o"></div>`;
+		const blank = el.querySelector('.fl-blank');
+		const ctl = mountChoice(el.querySelector('[data-r=o]'), v, api, {
+			onPick(i) {
+				blank.textContent = v.opts[i];
+				blank.classList.add('set');
+			},
+		});
+		return {
+			lock: ctl.lock,
+			reveal(results) {
+				ctl.reveal(results);
+				const mine = ctl.mine;
+				blank.classList.add('set');
+				if (mine === v.right) blank.classList.add('right');
+				else {
+					if (mine != null) blank.classList.add('wrong');
+					blank.textContent = v.opts[mine ?? v.right];
+					setTimeout(() => {
+						blank.classList.remove('wrong');
+						blank.classList.add('right');
+						blank.textContent = v.opts[v.right];
+					}, 650);
+				}
+			},
+			destroy() {},
+		};
+	},
+	...choiceKind({ bot: (v, s, R) => choiceBot(v, s, R, [3, 6], 0.03) }),
+};
+
+// ---------------------------------------------------------------- riddle
+export const riddle = {
+	time: 20,
+	label: 'Bilmece',
+	prepare: (q, R) => prepChoice(q, R),
