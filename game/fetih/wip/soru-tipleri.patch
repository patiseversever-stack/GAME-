@@ -0,0 +1,132 @@
+// Mini çengel bulmaca yerleştirici.
+// layout(words, R) → { rows, cols, words: [{w, clue, r, c, dir:'a'|'d', n}], cells: [{r,c,ch}], ok }
+// Kural: her yeni kelime en az bir harfte öncekilerle kesişir; yan yana değen ama kesişmeyen harf olmaz.
+// 'a' = yatay (soldan sağa), 'd' = dikey (yukarıdan aşağı).
+
+const key = (r, c) => r + ',' + c;
+
+function fits(grid, w, r, c, dir) {
+	const dr = dir === 'd' ? 1 : 0;
+	const dc = dir === 'a' ? 1 : 0;
+	// kelimenin öncesi ve sonrası boş olmalı
+	if (grid.has(key(r - dr, c - dc)) || grid.has(key(r + dr * w.length, c + dc * w.length))) return -1;
+	let cross = 0;
+	for (let i = 0; i < w.length; i++) {
+		const rr = r + dr * i;
+		const cc = c + dc * i;
+		const cell = grid.get(key(rr, cc));
+		if (cell) {
+			if (cell.ch !== w[i] || cell.dirs.has(dir)) return -1;
+			cross++;
+		} else {
+			// kesişmeyen hücrenin yan komşuları boş olmalı
+			if (grid.has(key(rr + dc, cc + dr)) || grid.has(key(rr - dc, cc - dr))) return -1;
+		}
+	}
+	return cross;
+}
+
+function put(grid, w, r, c, dir) {
+	const dr = dir === 'd' ? 1 : 0;
+	const dc = dir === 'a' ? 1 : 0;
+	for (let i = 0; i < w.length; i++) {
+		const k = key(r + dr * i, c + dc * i);
+		const cell = grid.get(k);
+		if (cell) cell.dirs.add(dir);
+		else grid.set(k, { ch: w[i], dirs: new Set([dir]) });
+	}
+}
+
+function bounds(placed) {
+	let r0 = 1e9;
+	let c0 = 1e9;
+	let r1 = -1e9;
+	let c1 = -1e9;
+	for (const p of placed) {
+		const er = p.r + (p.dir === 'd' ? p.w.length - 1 : 0);
+		const ec = p.c + (p.dir === 'a' ? p.w.length - 1 : 0);
+		r0 = Math.min(r0, p.r);
+		c0 = Math.min(c0, p.c);
+		r1 = Math.max(r1, er);
+		c1 = Math.max(c1, ec);
+	}
+	return { r0, c0, r1, c1, rows: r1 - r0 + 1, cols: c1 - c0 + 1 };
+}
+
+function attempt(items, R) {
+	const grid = new Map();
+	const placed = [];
+	const first = items[0];
+	put(grid, first.w, 0, 0, 'a');
+	placed.push({ ...first, r: 0, c: 0, dir: 'a' });
+	let crossings = 0;
+	for (let k = 1; k < items.length; k++) {
+		const it = items[k];
+		let best = null;
+		for (const p of placed) {
+			const pd = p.dir;
+			const dir = pd === 'a' ? 'd' : 'a';
+			for (let i = 0; i < p.w.length; i++) {
+				for (let j = 0; j < it.w.length; j++) {
+					if (p.w[i] !== it.w[j]) continue;
+					// p'nin i. harfi it'in j. harfi olacak
+					const pr = p.r + (pd === 'd' ? i : 0);
+					const pc = p.c + (pd === 'a' ? i : 0);
+					const r = dir === 'd' ? pr - j : pr;
+					const c = dir === 'a' ? pc - j : pc;
+					const x = fits(grid, it.w, r, c, dir);
+					if (x < 1) continue;
+					const test = bounds([...placed, { w: it.w, r, c, dir }]);
+					const score = x * 3 - test.rows * test.cols * 0.08 - Math.abs(test.rows - test.cols) * 0.4 + R() * 0.6;
+					if (!best || score > best.score) best = { r, c, dir, score, x };
+				}
+			}
+		}
+		if (!best) return null;
+		put(grid, it.w, best.r, best.c, best.dir);
+		placed.push({ ...it, r: best.r, c: best.c, dir: best.dir });
+		crossings += best.x;
+	}
+	const b = bounds(placed);
+	return { placed, b, crossings, grid };
+}
+
+export function layout(words, R = Math.random) {
+	const base = words.map((x) => ({ w: x.w, clue: x.clue }));
+	let best = null;
+	for (let t = 0; t < 60; t++) {
+		// ilk kelime uzun olsun; geri kalanı karışık
+		const rest = base.slice().sort(() => R() - 0.5);
+		rest.sort((a, b) => b.w.length - a.w.length + (R() - 0.5) * 2.5);
+		const res = attempt(rest, R);
+		if (!res) continue;
+		const area = res.b.rows * res.b.cols;
+		const score = -area - Math.abs(res.b.rows - res.b.cols) * 1.5 + res.crossings * 2;
+		if (!best || score > best.score) best = { ...res, score };
+	}
+	if (!best) {
+		// yedek: hepsini alt alta, kesişmesiz yatay yerleştir (içerik hatası; oyun yine de çalışır)
+		const placed = base.map((x, i) => ({ ...x, r: i * 2, c: 0, dir: 'a' }));
+		const grid = new Map();
+		for (const p of placed) put(grid, p.w, p.r, p.c, 'a');
+		best = { placed, b: bounds(placed), grid, crossings: 0 };
+		best.ok = false;
+	} else best.ok = true;
+	const { r0, c0, rows, cols } = best.b;
+	const out = best.placed.map((p) => ({ w: p.w, clue: p.clue, r: p.r - r0, c: p.c - c0, dir: p.dir }));
+	// numaralandırma: okuma sırası (satır, sütun); aynı başlangıç hücresi aynı numarayı alır
+	const starts = [...new Set(out.map((p) => p.r * 100 + p.c))].sort((a, b) => a - b);
+	for (const p of out) p.n = starts.indexOf(p.r * 100 + p.c) + 1;
+	out.sort((a, b) => a.n - b.n || (a.dir === 'a' ? -1 : 1));
+	const cells = [];
+	const seen = new Set();
+	for (const p of out)
+		for (let i = 0; i < p.w.length; i++) {
+			const r = p.r + (p.dir === 'd' ? i : 0);
+			const c = p.c + (p.dir === 'a' ? i : 0);
+			if (seen.has(key(r, c))) continue;
+			seen.add(key(r, c));
+			cells.push({ r, c, ch: p.w[i] });
+		}
+	return { rows, cols, words: out, cells, ok: best.ok };
+}
diff --git a/game/fetih/src/quiz/t_blitz.js b/game/fetih/src/quiz/t_blitz.js
new file mode 100644
index 0000000..bbc7670
--- /dev/null
+++ b/game/fetih/src/quiz/t_blitz.js
@@ -0,0 +1,156 @@
+// YILDIRIM TURU: 10 saniyede olabildiğince çok "doğru mu yanlış mı" bil.
+// Veri: items: [{t, ans}, ×12..16]  (t kısa ifade, ans true/false). Her oyunda karıştırılır.
+// Değer: { score, n }  (score = doğru sayısı, n = cevaplanan ifade sayısı).
+//
+// SIRALAMA: tür 'closest'. judge → err = −score; yani çok doğru yapan önde. Eşitlikte `time` (daha erken
+// bitiren) belirler. İnsan süre dolunca otomatik gönderilir (arayüz value() ile skoru okur, time = süre);
+// botlar süre sonunda bitirmiş sayılır. correct = skor en az 5.
+// Yanlış cevap 0.6 sn'lik bir kilitlenme getirir (rastgele basarak puan toplanmasın).
+
+import { css, esc, shuffle, pCorrect, clamp, buzz, chips } from './util.js';
+
+const CSS = /* css */ `
+.fl-bz{display:flex;flex-direction:column;gap:10px}
+.fl-bz-top{display:flex;align-items:center;gap:10px}
+.fl-bz-score{font-family:'Lilita One';font-weight:400;font-size:40px;line-height:1;color:var(--gold);text-shadow:0 3px 0 #3a2000;min-width:1.4em;transition:transform .15s}
+.fl-bz-score.pop{transform:scale(1.35)}
+.fl-bz-top small{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.75}
+.fl-bz-combo{margin-left:auto;font-family:'Lilita One';font-size:18px;color:#ff8a3a;opacity:0;transform:scale(.6);transition:opacity .2s,transform .25s cubic-bezier(.3,1.6,.5,1)}
+.fl-bz-combo.on{opacity:1;transform:scale(1)}
+.fl-bz-stage{position:relative;min-height:116px;display:grid;place-items:center;overflow:hidden;border-radius:18px;padding:14px;text-align:center;
+  background:linear-gradient(180deg,rgba(255,255,255,.16),rgba(255,255,255,.06));border:2.5px solid rgba(255,255,255,.28);font-size:clamp(19px,5.4vw,24px);line-height:1.25;text-wrap:balance}
+.fl-bz-stage span{display:block;animation:flq-slide .2s ease-out}
+.fl-bz-stage.ok{border-color:#7dff9a;box-shadow:0 0 0 3px rgba(125,255,154,.35)}
+.fl-bz-stage.no{border-color:#ff6a5a;box-shadow:0 0 0 3px rgba(255,106,90,.35);animation:flq-shake .38s}
+.fl-bz .fl-tf .fl-opt{min-height:72px}
+.fl-bz.lock .fl-tf .fl-opt{opacity:.4;pointer-events:none}
+.fl-bz-log{display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-top:2px}
+.fl-bz-log i{width:20px;height:20px;border-radius:6px;display:grid;place-items:center;font-style:normal;font-size:12px;font-weight:700}
+.fl-bz-log i.y{background:#2a9a44}.fl-bz-log i.n{background:#c8352a}
+.fl-bz-final{text-align:center;font-family:'Lilita One';font-size:28px;color:#7dff9a;margin:2px 0}
+.fl-bz-rows{display:flex;flex-direction:column;gap:3px;font-size:13px;text-align:left}
+.fl-bz-rows div{display:flex;gap:8px;align-items:center;padding:3px 8px;border-radius:8px;background:rgba(255,255,255,.06)}
+.fl-bz-rows div.n{background:rgba(255,80,60,.2)}
+.fl-bz-rows em{margin-left:auto;font-style:normal;font-family:'Lilita One';opacity:.8}
+@keyframes flq-slide{from{transform:translateX(26px);opacity:0}to{transform:none;opacity:1}}
+`;
+
+export const blitz = {
+	time: 10,
+	label: 'Yıldırım turu',
+	kind: 'closest',
+	prepare(q, R) {
+		return { q, items: shuffle(q.items, R) };
+	},
+	mount(el, v, api) {
+		css('blitz', CSS);
+		const items = v.items;
+		el.innerHTML = `<div class="fl-bz">
+			<div class="fl-bz-top"><b class="fl-bz-score">0</b><small>doğru</small><span class="fl-bz-combo"></span></div>
+			<div class="fl-bz-stage"><span></span></div>
+			<div class="fl-tf"><button class="fl-opt fl-yes" data-a="1"><span>DOĞRU</span></button><button class="fl-opt fl-no" data-a="0"><span>YANLIŞ</span></button></div>
+			<div data-r="x"></div>
+		</div>`;
+		const root = el.querySelector('.fl-bz');
+		const stage = root.querySelector('.fl-bz-stage');
+		const txt = stage.firstChild;
+		const scoreEl = root.querySelector('.fl-bz-score');
+		const comboEl = root.querySelector('.fl-bz-combo');
+		let k = 0; // sıradaki ifade
+		let score = 0;
+		let combo = 0;
+		let done = false;
+		let lock = false;
+		const log = [];
+		const show = () => {
+			txt.style.animation = 'none';
+			void txt.offsetWidth;
+			txt.style.animation = '';
+			txt.textContent = items[k].t;
+		};
+		show();
+		const finish = () => {
+			if (done) return;
+			done = true;
+			api.answer({ score, n: log.length });
+		};
+		const flash = (cls) => {
+			stage.classList.remove('ok', 'no');
+			void stage.offsetWidth;
+			stage.classList.add(cls);
+			setTimeout(() => stage.classList.remove(cls), 330);
+		};
+		root.querySelector('.fl-tf').addEventListener('click', (e) => {
+			const b = e.target.closest('.fl-opt');
+			if (!b || done || lock) return;
+			const say = b.dataset.a === '1';
+			const it = items[k];
+			const ok = say === !!it.ans;
+			log.push({ t: it.t, ans: !!it.ans, ok });
+			if (ok) {
+				score++;
+				combo++;
+				scoreEl.textContent = score;
+				scoreEl.classList.add('pop');
+				setTimeout(() => scoreEl.classList.remove('pop'), 150);
+				flash('ok');
+				buzz(6);
+				comboEl.textContent = combo >= 3 ? `🔥 x${combo}` : '';
+				comboEl.classList.toggle('on', combo >= 3);
+			} else {
+				combo = 0;
+				comboEl.classList.remove('on');
+				flash('no');
+				buzz(40);
+				lock = true;
+				root.classList.add('lock');
+				setTimeout(() => {
+					lock = false;
+					root.classList.remove('lock');
+				}, 600);
+			}
+			k++;
+			if (k >= items.length) return finish();
+			show();
+		});
+		return {
+			lock() {
+				done = true;
+			},
+			value: () => ({ score, n: log.length }),
+			reveal(results) {
+				done = true;
+				const x = root.querySelector('[data-r=x]');
+				root.querySelector('.fl-tf').style.display = 'none';
+				stage.style.display = 'none';
+				const sc = (r) => (r.value ? r.value.score : 0);
+				x.innerHTML = `<div class="fl-bz-final">${score} doğru!</div>
+					<div class="fl-bz-rows">${log
+						.slice(-6)
+						.map((l) => `<div class="${l.ok ? '' : 'n'}"><span>${l.ok ? '✓' : '✗'}</span><span>${esc(l.t)}</span><em>${l.ans ? 'Doğru' : 'Yanlış'}</em></div>`)
+						.join('')}</div>${chips(results, (r) => sc(r) + ' doğru')}`;
+			},
+			destroy() {},
+		};
+	},
+	judge(v, value) {
+		const score = value ? value.score || 0 : 0;
+		return { correct: score >= 5, err: -score, score };
+	},
+	bot(v, skill, R) {
+		// her ifade ~ (1.5 − 0.6·beceri) sn: okuma ve dokunma. Yanlış: 0.6 sn ceza.
+		const per = 1.55 - 0.6 * skill;
+		const p = clamp(pCorrect(skill, v.q.diff) + 0.12, 0.2, 0.97);
+		let t = 0;
+		let score = 0;
+		let n = 0;
+		while (n < v.items.length) {
+			t += per * (0.75 + R() * 0.5);
+			if (t > blitz.time) break;
+			n++;
+			if (R() < p) score++;
+			else t += 0.6;
+		}
+		return { value: { score, n }, time: n >= v.items.length ? Math.min(t, blitz.time) : blitz.time };
+	},
+};
