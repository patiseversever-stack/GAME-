# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q27883 wd:Q62742 wd:Q63798 wd:Q64835 wd:Q66452 wd:Q75063 wd:Q77834 wd:Q139128 wd:Q148028 wd:Q167219 wd:Q176190 wd:Q183099 wd:Q205790 wd:Q247860 wd:Q260671 wd:Q262935 wd:Q270224 wd:Q343514 wd:Q343838 wd:Q344150 wd:Q344220 wd:Q345949 wd:Q349197 wd:Q355634 wd:Q355638 wd:Q358528 wd:Q374415 wd:Q389025 wd:Q401421 wd:Q401768 wd:Q401780 wd:Q403535 wd:Q407365 wd:Q440361 wd:Q442766 wd:Q462689 wd:Q562157 wd:Q573056 wd:Q576731 wd:Q616132 wd:Q642529 wd:Q644315 wd:Q651954 wd:Q666227 wd:Q678483 wd:Q706747 wd:Q709089 wd:Q718457 wd:Q722705 wd:Q735674 wd:Q736523 wd:Q739376 wd:Q758354 wd:Q758356 wd:Q767468 wd:Q779006 wd:Q782976 wd:Q784583 wd:Q913571 wd:Q925035 wd:Q953983 wd:Q968128 wd:Q1020698 wd:Q1020701 wd:Q1052760 wd:Q1196101 wd:Q1264350 wd:Q1276263 wd:Q1362522 wd:Q1366613 wd:Q1372203 wd:Q1372262 wd:Q1372923 wd:Q1374883 wd:Q1383555 wd:Q1400465 wd:Q1529380 wd:Q1561127 wd:Q1569701 wd:Q1584105 wd:Q1584693 wd:Q1796711 wd:Q2257564 wd:Q2389180 wd:Q2455610 wd:Q2479772 wd:Q2509312 wd:Q2537009 wd:Q2561556 wd:Q2641968 wd:Q2657786 wd:Q2672088 wd:Q2696775 wd:Q2729985 wd:Q2755394 wd:Q2908686 wd:Q3009177 wd:Q3057088 wd:Q3133071 wd:Q3141040 wd:Q3176600 wd:Q3177852 wd:Q3299081 wd:Q3306251 wd:Q3307760 wd:Q3337737 wd:Q3366131 wd:Q3394737 wd:Q3437548 wd:Q3500784 wd:Q3542498 wd:Q3561135 wd:Q3561143 wd:Q3643128 wd:Q3646767 wd:Q3653165 wd:Q3658437 wd:Q3701685 wd:Q3714820 wd:Q3775651 wd:Q3814892 wd:Q3825050 wd:Q3827158 wd:Q4292197 wd:Q4403513 wd:Q4445734 wd:Q4492353 wd:Q4822657 wd:Q4844437 wd:Q4887634 wd:Q5257864 wd:Q5267608 wd:Q5397960 wd:Q5626824 wd:Q5626869 wd:Q6030503 wd:Q6037996 wd:Q6052906 wd:Q6062235 wd:Q6063893 wd:Q6067217 wd:Q6070346 wd:Q6085288 wd:Q6086593 wd:Q6086743 wd:Q6086955 wd:Q6096781 wd:Q6098127 wd:Q6419363 wd:Q6424688 wd:Q6574418 wd:Q7273017 wd:Q7283651 wd:Q8050417 wd:Q8077778 wd:Q8080093 wd:Q8082462 wd:Q11967095 wd:Q12071778 wd:Q12808445 wd:Q12809520 wd:Q12809907 wd:Q13052750 wd:Q14213946 wd:Q14623225 wd:Q14972100 wd:Q15091752 wd:Q15526969 wd:Q15734040 wd:Q16031566 wd:Q16059449 wd:Q16235973 wd:Q16931526 wd:Q16939232 wd:Q18206279 wd:Q18206358 wd:Q18206912 wd:Q18634715 wd:Q19895333 wd:Q19950828 wd:Q20470555 wd:Q21523792 wd:Q23920665 wd:Q24852709 wd:Q28358464 wd:Q30062866 wd:Q30195347 wd:Q33528589 wd:Q40467872 wd:Q41806462 wd:Q43374020 wd:Q46639312 wd:Q55526162 wd:Q64224438 wd:Q65925194 wd:Q89350358 wd:Q97370737 wd:Q98278062 wd:Q110486415 wd:Q128035509 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
