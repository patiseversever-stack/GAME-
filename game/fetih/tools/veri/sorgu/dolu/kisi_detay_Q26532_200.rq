# Kişi ayrıntıları; wd:Q26532 wd:Q71402 wd:Q77684 wd:Q96890 wd:Q119339 wd:Q130164 wd:Q140092 wd:Q187253 wd:Q224535 wd:Q270082 wd:Q289377 wd:Q301493 wd:Q308154 wd:Q317630 wd:Q317793 wd:Q318008 wd:Q330913 wd:Q334843 wd:Q343295 wd:Q343415 wd:Q343590 wd:Q352882 wd:Q388823 wd:Q390568 wd:Q390718 wd:Q403564 wd:Q428250 wd:Q447679 wd:Q452203 wd:Q452971 wd:Q459806 wd:Q464692 wd:Q464856 wd:Q470307 wd:Q523871 wd:Q556175 wd:Q570978 wd:Q577265 wd:Q627917 wd:Q659367 wd:Q663918 wd:Q690376 wd:Q697343 wd:Q710110 wd:Q713757 wd:Q715543 wd:Q716933 wd:Q718684 wd:Q720344 wd:Q722053 wd:Q729830 wd:Q735658 wd:Q792898 wd:Q793872 wd:Q803667 wd:Q810440 wd:Q814476 wd:Q819597 wd:Q841465 wd:Q930862 wd:Q961343 wd:Q980330 wd:Q982414 wd:Q983013 wd:Q983294 wd:Q983601 wd:Q984363 wd:Q1053402 wd:Q1110673 wd:Q1136035 wd:Q1151281 wd:Q1152011 wd:Q1187856 wd:Q1225326 wd:Q1238755 wd:Q1262170 wd:Q1348747 wd:Q1366042 wd:Q1396517 wd:Q1397239 wd:Q1584117 wd:Q1657989 wd:Q1686749 wd:Q1974330 wd:Q1980285 wd:Q2043226 wd:Q2081158 wd:Q2081284 wd:Q2091186 wd:Q2092426 wd:Q2110643 wd:Q2162025 wd:Q2166481 wd:Q2369824 wd:Q2475961 wd:Q2479819 wd:Q2479841 wd:Q2480100 wd:Q2528665 wd:Q2533343 wd:Q2553454 wd:Q2571543 wd:Q2594185 wd:Q2672296 wd:Q2696796 wd:Q2749858 wd:Q2893594 wd:Q2920160 wd:Q2976924 wd:Q2980755 wd:Q2981307 wd:Q3074376 wd:Q3108218 wd:Q3128310 wd:Q3131402 wd:Q3180990 wd:Q3206275 wd:Q3280529 wd:Q3296742 wd:Q3299101 wd:Q3393215 wd:Q3434979 wd:Q3480773 wd:Q3556309 wd:Q3571371 wd:Q3593699 wd:Q3667328 wd:Q3774507 wd:Q3777403 wd:Q3816343 wd:Q3824866 wd:Q4115112 wd:Q4165808 wd:Q4166497 wd:Q4483294 wd:Q4695880 wd:Q4705522 wd:Q4716562 wd:Q4821617 wd:Q5312702 wd:Q5423258 wd:Q5448245 wd:Q6003194 wd:Q6026764 wd:Q6039259 wd:Q6043452 wd:Q6057843 wd:Q6061464 wd:Q6062210 wd:Q6066019 wd:Q6067391 wd:Q6082351 wd:Q6220872 wd:Q6383452 wd:Q6404816 wd:Q6538025 wd:Q6825651 wd:Q6956143 wd:Q7081156 wd:Q8063471 wd:Q8079147 wd:Q11089630 wd:Q12288056 wd:Q12808659 wd:Q13377800 wd:Q13534457 wd:Q13572006 wd:Q15051577 wd:Q15363466 wd:Q15402112 wd:Q15928713 wd:Q16123660 wd:Q17037387 wd:Q17045544 wd:Q17432294 wd:Q18121943 wd:Q20164837 wd:Q20640548 wd:Q21523791 wd:Q23654933 wd:Q26237147 wd:Q27063857 wd:Q27990700 wd:Q28736630 wd:Q28758684 wd:Q56173816 wd:Q60050402 wd:Q65237950 wd:Q76985040 wd:Q80713297 wd:Q83732440 wd:Q83961974 wd:Q85196908 wd:Q85974051 wd:Q85974935 wd:Q90351487 wd:Q96279157 wd:Q105810943 wd:Q107463107 wd:Q112081403 yerine getir.mjs en çok 400 kişilik bir öbek koyar.
# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q26532 wd:Q71402 wd:Q77684 wd:Q96890 wd:Q119339 wd:Q130164 wd:Q140092 wd:Q187253 wd:Q224535 wd:Q270082 wd:Q289377 wd:Q301493 wd:Q308154 wd:Q317630 wd:Q317793 wd:Q318008 wd:Q330913 wd:Q334843 wd:Q343295 wd:Q343415 wd:Q343590 wd:Q352882 wd:Q388823 wd:Q390568 wd:Q390718 wd:Q403564 wd:Q428250 wd:Q447679 wd:Q452203 wd:Q452971 wd:Q459806 wd:Q464692 wd:Q464856 wd:Q470307 wd:Q523871 wd:Q556175 wd:Q570978 wd:Q577265 wd:Q627917 wd:Q659367 wd:Q663918 wd:Q690376 wd:Q697343 wd:Q710110 wd:Q713757 wd:Q715543 wd:Q716933 wd:Q718684 wd:Q720344 wd:Q722053 wd:Q729830 wd:Q735658 wd:Q792898 wd:Q793872 wd:Q803667 wd:Q810440 wd:Q814476 wd:Q819597 wd:Q841465 wd:Q930862 wd:Q961343 wd:Q980330 wd:Q982414 wd:Q983013 wd:Q983294 wd:Q983601 wd:Q984363 wd:Q1053402 wd:Q1110673 wd:Q1136035 wd:Q1151281 wd:Q1152011 wd:Q1187856 wd:Q1225326 wd:Q1238755 wd:Q1262170 wd:Q1348747 wd:Q1366042 wd:Q1396517 wd:Q1397239 wd:Q1584117 wd:Q1657989 wd:Q1686749 wd:Q1974330 wd:Q1980285 wd:Q2043226 wd:Q2081158 wd:Q2081284 wd:Q2091186 wd:Q2092426 wd:Q2110643 wd:Q2162025 wd:Q2166481 wd:Q2369824 wd:Q2475961 wd:Q2479819 wd:Q2479841 wd:Q2480100 wd:Q2528665 wd:Q2533343 wd:Q2553454 wd:Q2571543 wd:Q2594185 wd:Q2672296 wd:Q2696796 wd:Q2749858 wd:Q2893594 wd:Q2920160 wd:Q2976924 wd:Q2980755 wd:Q2981307 wd:Q3074376 wd:Q3108218 wd:Q3128310 wd:Q3131402 wd:Q3180990 wd:Q3206275 wd:Q3280529 wd:Q3296742 wd:Q3299101 wd:Q3393215 wd:Q3434979 wd:Q3480773 wd:Q3556309 wd:Q3571371 wd:Q3593699 wd:Q3667328 wd:Q3774507 wd:Q3777403 wd:Q3816343 wd:Q3824866 wd:Q4115112 wd:Q4165808 wd:Q4166497 wd:Q4483294 wd:Q4695880 wd:Q4705522 wd:Q4716562 wd:Q4821617 wd:Q5312702 wd:Q5423258 wd:Q5448245 wd:Q6003194 wd:Q6026764 wd:Q6039259 wd:Q6043452 wd:Q6057843 wd:Q6061464 wd:Q6062210 wd:Q6066019 wd:Q6067391 wd:Q6082351 wd:Q6220872 wd:Q6383452 wd:Q6404816 wd:Q6538025 wd:Q6825651 wd:Q6956143 wd:Q7081156 wd:Q8063471 wd:Q8079147 wd:Q11089630 wd:Q12288056 wd:Q12808659 wd:Q13377800 wd:Q13534457 wd:Q13572006 wd:Q15051577 wd:Q15363466 wd:Q15402112 wd:Q15928713 wd:Q16123660 wd:Q17037387 wd:Q17045544 wd:Q17432294 wd:Q18121943 wd:Q20164837 wd:Q20640548 wd:Q21523791 wd:Q23654933 wd:Q26237147 wd:Q27063857 wd:Q27990700 wd:Q28736630 wd:Q28758684 wd:Q56173816 wd:Q60050402 wd:Q65237950 wd:Q76985040 wd:Q80713297 wd:Q83732440 wd:Q83961974 wd:Q85196908 wd:Q85974051 wd:Q85974935 wd:Q90351487 wd:Q96279157 wd:Q105810943 wd:Q107463107 wd:Q112081403 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
