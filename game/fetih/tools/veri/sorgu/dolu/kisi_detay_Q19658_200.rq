# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q19658 wd:Q25839 wd:Q77240 wd:Q78763 wd:Q140168 wd:Q177296 wd:Q209826 wd:Q223435 wd:Q246560 wd:Q247287 wd:Q255645 wd:Q256625 wd:Q259405 wd:Q271541 wd:Q297516 wd:Q298184 wd:Q303651 wd:Q307835 wd:Q317612 wd:Q343327 wd:Q343341 wd:Q366571 wd:Q367997 wd:Q369878 wd:Q372161 wd:Q373424 wd:Q388771 wd:Q421531 wd:Q443079 wd:Q446945 wd:Q455536 wd:Q458740 wd:Q461500 wd:Q464682 wd:Q469443 wd:Q469525 wd:Q469770 wd:Q471572 wd:Q472202 wd:Q536298 wd:Q541724 wd:Q542368 wd:Q546023 wd:Q548064 wd:Q551564 wd:Q555004 wd:Q556796 wd:Q559158 wd:Q559228 wd:Q572436 wd:Q574899 wd:Q577254 wd:Q610062 wd:Q611767 wd:Q660970 wd:Q664549 wd:Q692133 wd:Q708808 wd:Q719389 wd:Q732272 wd:Q735511 wd:Q739401 wd:Q740385 wd:Q753168 wd:Q758126 wd:Q787409 wd:Q793007 wd:Q836500 wd:Q838407 wd:Q924558 wd:Q926715 wd:Q936634 wd:Q951058 wd:Q961981 wd:Q982397 wd:Q982419 wd:Q982905 wd:Q983535 wd:Q1020672 wd:Q1054731 wd:Q1076524 wd:Q1151724 wd:Q1167073 wd:Q1176678 wd:Q1189261 wd:Q1263511 wd:Q1280525 wd:Q1285498 wd:Q1339629 wd:Q1346942 wd:Q1347777 wd:Q1366118 wd:Q1382028 wd:Q1382418 wd:Q1388570 wd:Q1388882 wd:Q1395064 wd:Q1397975 wd:Q1400345 wd:Q1528120 wd:Q1528131 wd:Q1531115 wd:Q1572046 wd:Q1572401 wd:Q1585494 wd:Q1587824 wd:Q1588094 wd:Q1616864 wd:Q1679740 wd:Q1816615 wd:Q1892131 wd:Q1941165 wd:Q2001807 wd:Q2073498 wd:Q2264534 wd:Q2272090 wd:Q2305326 wd:Q2330163 wd:Q2361609 wd:Q2372811 wd:Q2392015 wd:Q2397796 wd:Q2449920 wd:Q2453214 wd:Q2479782 wd:Q2598603 wd:Q2606697 wd:Q2610519 wd:Q2637668 wd:Q2810222 wd:Q2827697 wd:Q2947626 wd:Q2982590 wd:Q3054263 wd:Q3103765 wd:Q3113776 wd:Q3126013 wd:Q3306683 wd:Q3493526 wd:Q3545202 wd:Q3562673 wd:Q3566640 wd:Q3622237 wd:Q3624123 wd:Q3674672 wd:Q3820159 wd:Q3986790 wd:Q4115227 wd:Q4115413 wd:Q4116132 wd:Q4116882 wd:Q4845407 wd:Q4893443 wd:Q6003966 wd:Q6027272 wd:Q6028763 wd:Q6097526 wd:Q6120646 wd:Q6153148 wd:Q6760891 wd:Q7116454 wd:Q7488132 wd:Q12069604 wd:Q12811870 wd:Q12812557 wd:Q12812869 wd:Q13225104 wd:Q14911948 wd:Q15043373 wd:Q15440590 wd:Q15857490 wd:Q16213909 wd:Q17386617 wd:Q18206130 wd:Q19411693 wd:Q19936977 wd:Q20988308 wd:Q21044620 wd:Q21431389 wd:Q21524192 wd:Q21528448 wd:Q23063191 wd:Q23654861 wd:Q23688821 wd:Q24265525 wd:Q26206676 wd:Q26234867 wd:Q27832286 wd:Q29261128 wd:Q43387229 wd:Q52450733 wd:Q55384174 wd:Q56745574 wd:Q62550371 wd:Q63073360 wd:Q64910596 wd:Q70720436 wd:Q99524444 wd:Q108802005 wd:Q123174990 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
