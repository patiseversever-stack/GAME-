+		return { lock: ctl.lock, reveal: (r) => ctl.reveal(r), destroy() {} };
+	},
+	...choiceKind({ bot: (v, s, R) => choiceBot(v, s, R, [4, 8], -0.02) }),
+};
diff --git a/game/fetih/src/quiz/t_word.js b/game/fetih/src/quiz/t_word.js
