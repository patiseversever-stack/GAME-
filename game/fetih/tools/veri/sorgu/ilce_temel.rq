# "district of Turkey" (Q1147395) örnekleri: site bağlantısı sayısı, trwiki başlığı,
# kapatılma (P576), yerine geçen (P1366) ve P31 deyiminin bitiş tarihi (P582).
SELECT ?d ?sl ?trwiki ?kapanis ?yerine ?p31bitis WHERE {
  ?d p:P31 ?s31 . ?s31 ps:P31 wd:Q1147395 .
  ?d wikibase:sitelinks ?sl .
  OPTIONAL { ?s31 pq:P582 ?p31bitis }
  OPTIONAL { ?w schema:about ?d ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?trwiki }
  OPTIONAL { ?d wdt:P576 ?kapanis }
  OPTIONAL { ?d wdt:P1366 ?yerine }
}
ORDER BY ?d ?yerine ?kapanis ?p31bitis
