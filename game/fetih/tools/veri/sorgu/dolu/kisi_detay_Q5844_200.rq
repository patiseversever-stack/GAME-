# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q5844 wd:Q28862 wd:Q60836 wd:Q62848 wd:Q77662 wd:Q78168 wd:Q115486 wd:Q165866 wd:Q167451 wd:Q174961 wd:Q187273 wd:Q202971 wd:Q207009 wd:Q248058 wd:Q250519 wd:Q255210 wd:Q264949 wd:Q270201 wd:Q271549 wd:Q272732 wd:Q273398 wd:Q280422 wd:Q297461 wd:Q343494 wd:Q385995 wd:Q401758 wd:Q401773 wd:Q422915 wd:Q433257 wd:Q434903 wd:Q437231 wd:Q459130 wd:Q524203 wd:Q534514 wd:Q546028 wd:Q546577 wd:Q552253 wd:Q555534 wd:Q567406 wd:Q569272 wd:Q573330 wd:Q579354 wd:Q596388 wd:Q603855 wd:Q641011 wd:Q651247 wd:Q660545 wd:Q661466 wd:Q672104 wd:Q697476 wd:Q718025 wd:Q719388 wd:Q721709 wd:Q727569 wd:Q735711 wd:Q738441 wd:Q741465 wd:Q741754 wd:Q745216 wd:Q781172 wd:Q792834 wd:Q792891 wd:Q805549 wd:Q812595 wd:Q849017 wd:Q861909 wd:Q872353 wd:Q897430 wd:Q912441 wd:Q942151 wd:Q945940 wd:Q947840 wd:Q953972 wd:Q963285 wd:Q970249 wd:Q982721 wd:Q983357 wd:Q983638 wd:Q983917 wd:Q1031882 wd:Q1052624 wd:Q1053340 wd:Q1151023 wd:Q1275426 wd:Q1277819 wd:Q1284614 wd:Q1290045 wd:Q1293317 wd:Q1339426 wd:Q1366156 wd:Q1372691 wd:Q1372790 wd:Q1378425 wd:Q1381467 wd:Q1384097 wd:Q1386256 wd:Q1388930 wd:Q1392181 wd:Q1392927 wd:Q1395698 wd:Q1398211 wd:Q1439300 wd:Q1487904 wd:Q1583786 wd:Q1584312 wd:Q1588141 wd:Q1606152 wd:Q1649344 wd:Q1653946 wd:Q1720967 wd:Q1811651 wd:Q2000855 wd:Q2028651 wd:Q2226174 wd:Q2306500 wd:Q2332596 wd:Q2334073 wd:Q2359636 wd:Q2365913 wd:Q2369623 wd:Q2377908 wd:Q2381876 wd:Q2423996 wd:Q2436603 wd:Q2473445 wd:Q2479808 wd:Q2541495 wd:Q2579462 wd:Q2616976 wd:Q2626563 wd:Q2642348 wd:Q2667107 wd:Q2667123 wd:Q2671172 wd:Q2785535 wd:Q2859996 wd:Q3481733 wd:Q3509731 wd:Q3624380 wd:Q3653188 wd:Q4164547 wd:Q4345779 wd:Q4455404 wd:Q4682828 wd:Q4857287 wd:Q4945471 wd:Q5963076 wd:Q6022166 wd:Q6038358 wd:Q6080013 wd:Q6085605 wd:Q6089269 wd:Q6090423 wd:Q6090759 wd:Q6091713 wd:Q6092023 wd:Q6096801 wd:Q6424690 wd:Q6943248 wd:Q7244305 wd:Q7449431 wd:Q8080030 wd:Q8080224 wd:Q9332564 wd:Q11182172 wd:Q11438225 wd:Q12526385 wd:Q12808436 wd:Q12811018 wd:Q13539238 wd:Q13574443 wd:Q15094075 wd:Q15613741 wd:Q15955450 wd:Q16027498 wd:Q16146392 wd:Q16166921 wd:Q17045542 wd:Q17330106 wd:Q18393109 wd:Q18982939 wd:Q19520337 wd:Q19636157 wd:Q19663514 wd:Q19950231 wd:Q20470988 wd:Q21191911 wd:Q21527193 wd:Q21528449 wd:Q23731544 wd:Q23834360 wd:Q27832572 wd:Q59641577 wd:Q60877822 wd:Q64010502 wd:Q67367529 wd:Q98262284 wd:Q98457368 wd:Q109282705 wd:Q118093594 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
