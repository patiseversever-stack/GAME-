# Önceki adımlarda trwiki sayfası bulunamayan ilçeler için başlıkla arama.
# "Arsin"@tr "Arsin (ilçe)"@tr "Arsin, Trabzon"@tr "Aslanapa"@tr "Aslanapa (ilçe)"@tr "Aslanapa, Kütahya"@tr "Bahşılı"@tr "Bahşılı (ilçe)"@tr "Bahşılı, Kırıkkale"@tr "Başiskele"@tr "Başiskele (ilçe)"@tr "Başiskele, Kocaeli"@tr "Bor"@tr "Bor (ilçe)"@tr "Bor, Niğde"@tr "Emet"@tr "Emet (ilçe)"@tr "Emet, Kütahya"@tr "Ergani"@tr "Ergani (ilçe)"@tr "Ergani, Diyarbakır"@tr "Ezine"@tr "Ezine (ilçe)"@tr "Ezine, Çanakkale"@tr "Harran"@tr "Harran (ilçe)"@tr "Harran, Şanlıurfa"@tr "Karatay"@tr "Karatay (ilçe)"@tr "Karatay, Konya"@tr "Kayapınar"@tr "Kayapınar (ilçe)"@tr "Kayapınar, Diyarbakır"@tr "Merzifon"@tr "Merzifon (ilçe)"@tr "Merzifon, Amasya"@tr "Seben"@tr "Seben (ilçe)"@tr "Seben, Bolu"@tr "Tefenni"@tr "Tefenni (ilçe)"@tr "Tefenni, Burdur"@tr "Tokat"@tr "Tokat (ilçe)"@tr "Tokat, Tokat"@tr "Yahşihan"@tr "Yahşihan (ilçe)"@tr "Yahşihan, Kırıkkale"@tr "Yenice"@tr "Yenice (ilçe)"@tr "Yenice, Çanakkale"@tr "Yenimahalle"@tr "Yenimahalle (ilçe)"@tr "Yenimahalle, Ankara"@tr "Yenişehir"@tr "Yenişehir (ilçe)"@tr "Yenişehir, Diyarbakır"@tr "Yenişehir, Mersin"@tr "Yeşilyurt"@tr "Yeşilyurt (ilçe)"@tr "Yeşilyurt, Tokat"@tr "Çankaya"@tr "Çankaya (ilçe)"@tr "Çankaya, Ankara"@tr yerine getir.mjs aday başlıkları koyar ("Ad, İl", "Ad (ilçe)", "Ad"); doldurulmuş hali
# sorgu/dolu/ilce_trwiki_baslik_<özet>.rq dosyasına yazılır. Anlam ayrımı sayfası mı, koordinatı ve P131'i ne?
SELECT ?baslik ?t ?sl ?anlam ?lat ?lon ?ust ?ustIl WHERE {
  VALUES ?baslik { "Arsin"@tr "Arsin (ilçe)"@tr "Arsin, Trabzon"@tr "Aslanapa"@tr "Aslanapa (ilçe)"@tr "Aslanapa, Kütahya"@tr "Bahşılı"@tr "Bahşılı (ilçe)"@tr "Bahşılı, Kırıkkale"@tr "Başiskele"@tr "Başiskele (ilçe)"@tr "Başiskele, Kocaeli"@tr "Bor"@tr "Bor (ilçe)"@tr "Bor, Niğde"@tr "Emet"@tr "Emet (ilçe)"@tr "Emet, Kütahya"@tr "Ergani"@tr "Ergani (ilçe)"@tr "Ergani, Diyarbakır"@tr "Ezine"@tr "Ezine (ilçe)"@tr "Ezine, Çanakkale"@tr "Harran"@tr "Harran (ilçe)"@tr "Harran, Şanlıurfa"@tr "Karatay"@tr "Karatay (ilçe)"@tr "Karatay, Konya"@tr "Kayapınar"@tr "Kayapınar (ilçe)"@tr "Kayapınar, Diyarbakır"@tr "Merzifon"@tr "Merzifon (ilçe)"@tr "Merzifon, Amasya"@tr "Seben"@tr "Seben (ilçe)"@tr "Seben, Bolu"@tr "Tefenni"@tr "Tefenni (ilçe)"@tr "Tefenni, Burdur"@tr "Tokat"@tr "Tokat (ilçe)"@tr "Tokat, Tokat"@tr "Yahşihan"@tr "Yahşihan (ilçe)"@tr "Yahşihan, Kırıkkale"@tr "Yenice"@tr "Yenice (ilçe)"@tr "Yenice, Çanakkale"@tr "Yenimahalle"@tr "Yenimahalle (ilçe)"@tr "Yenimahalle, Ankara"@tr "Yenişehir"@tr "Yenişehir (ilçe)"@tr "Yenişehir, Diyarbakır"@tr "Yenişehir, Mersin"@tr "Yeşilyurt"@tr "Yeşilyurt (ilçe)"@tr "Yeşilyurt, Tokat"@tr "Çankaya"@tr "Çankaya (ilçe)"@tr "Çankaya, Ankara"@tr }
  ?w schema:name ?baslik ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:about ?t .
  ?t wikibase:sitelinks ?sl .
  BIND(EXISTS { ?t wdt:P31 wd:Q4167410 } AS ?anlam)
  OPTIONAL { ?t p:P625/psv:P625 [ wikibase:geoLatitude ?lat ; wikibase:geoLongitude ?lon ] }
  OPTIONAL { ?t wdt:P131 ?ust . OPTIONAL { ?ustIl wdt:P36 ?ust ; wdt:P31 wd:Q48336 . } }
}
ORDER BY ?baslik ?t ?lat ?lon ?ust ?ustIl
