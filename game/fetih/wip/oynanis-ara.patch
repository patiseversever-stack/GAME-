+	osmanli_akinci: 'yeniceri',
+	osmanli_yeniceri: 'yeniceri',
+	osmanli_kaptan: 'yeniceri',
+	osmanli_sultan: 'sultan',
+	kurtulus_gonullu: 'kalpak',
+	kurtulus_subay: 'kalpak',
+	zeybek: 'kalpak',
+	astronot: 'astronot',
+	asci: 'asci',
+	ogretmen: 'selcuklu',
+	korsan: 'yeniceri',
+	ninja: 'gokturk',
+	simitci: 'asci',
+	dino: 'futbol',
+	robot: 'astronot',
+	mezun: 'kalpak',
+	kral_cay: 'asci',
