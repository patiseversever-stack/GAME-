+
+export function applyEffectDom(effect, { ui, app }) {
+	if (!HAS_DOM) return false;
+	const root = cardRoot(ui);
+	switch (effect.kind) {
+		case 'hide': {
+			const btns = root ? [...root.querySelectorAll('.fl-opt')] : [];
+			for (const i of effect.hide) {
+				const b = btns[i];
+				if (!b) continue;
+				b.disabled = true;
+				b.classList.add('fl-gone');
+				b.style.opacity = '0.14';
+				b.style.pointerEvents = 'none';
+				b.style.transform = 'scale(.96)';
+			}
+			return true;
+		}
+		case 'range': {
+			const r = root?.querySelector('.fl-range');
+			if (!r) return false;
+			r.min = String(effect.min);
+			r.max = String(effect.max);
+			r.value = String(Math.round((effect.min + effect.max) / 2));
+			r.dispatchEvent(new Event('input', { bubbles: true }));
+			return true;
+		}
+		case 'letters': {
+			for (const L of effect.letters) root?.querySelector(`.fl-key[data-k="${L}"]`)?.click();
+			return true;
+		}
+		case 'zone': {
+			const b = app?.board;
+			if (!b) return false;
+			for (const i of effect.provinces) b.fx(i, 0.22, 0.9);
+			setTimeout(() => {
+				for (const i of effect.provinces) b.fx(i, 0, 0);
+			}, 6000);
+			return true;
+		}
+		case 'poll': {
+			const btns = root ? [...root.querySelectorAll('.fl-opt')] : [];
+			effect.pct.forEach((p, i) => {
+				const b = btns[i];
+				if (!b || b.disabled) return;
+				if (getComputedStyle(b).position === 'static') b.style.position = 'relative';
+				b.insertAdjacentHTML(
+					'beforeend',
+					`<u style="position:absolute;left:0;bottom:0;height:5px;width:${p}%;background:#ffd25a;border-radius:0 3px 3px 0;pointer-events:none"></u><s style="position:absolute;right:10px;top:4px;font:700 12px Fredoka,system-ui;color:#ffd25a;text-decoration:none;pointer-events:none">%${p}</s>`,
+				);
+			});
+			return true;
+		}
+		case 'crowd': {
+			const host = root?.querySelector('.fl-num');
+			if (!host) return false;
+			host.insertAdjacentHTML(
+				'afterbegin',
+				`<div style="text-align:center;font:600 13px Fredoka,system-ui;color:#ffd25a;margin-bottom:4px">Seyirci tahmini: ~${effect.value.toLocaleString('tr-TR')} ${effect.unit || ''}</div>`,
+			);
+			return true;
+		}
+		case 'sabotage': {
+			if (!root) return false;
+			root.style.filter = 'blur(5px)';
+			setTimeout(() => (root.style.filter = ''), effect.blurMs || 2000);
+			return true;
+		}
+		default:
+			return false;
+	}
+}
+
+/** Kısa bildirim (arayüz `ui.toast` vermezse). */
+export function toastDom(ui, text, color = '#ffd25a') {
+	if (!HAS_DOM) return;
+	const host = ui?.el || document.body;
+	const t = document.createElement('div');
+	t.textContent = text;
+	t.style.cssText = `position:absolute;left:50%;top:92px;transform:translate(-50%,0);padding:7px 14px;border-radius:14px;background:rgba(16,26,51,.92);color:${color};font:600 14px Fredoka,system-ui;z-index:60;pointer-events:none;transition:opacity .4s,transform .4s;white-space:nowrap`;
+	host.appendChild(t);
+	setTimeout(() => {
+		t.style.opacity = '0';
+		t.style.transform = 'translate(-50%,-14px)';
+	}, 1600);
+	setTimeout(() => t.remove(), 2100);
