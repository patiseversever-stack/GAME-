# Kişi ayrıntıları; wd:Q60216 wd:Q67629 wd:Q67631 wd:Q67639 wd:Q174709 wd:Q179445 wd:Q187261 wd:Q195122 wd:Q236920 wd:Q255195 wd:Q263581 wd:Q271538 wd:Q271578 wd:Q273637 wd:Q283351 wd:Q283737 wd:Q307808 wd:Q317592 wd:Q326849 wd:Q327661 wd:Q328247 wd:Q338148 wd:Q343262 wd:Q343331 wd:Q343372 wd:Q344201 wd:Q344368 wd:Q349199 wd:Q353068 wd:Q366274 wd:Q367949 wd:Q378768 wd:Q388023 wd:Q390602 wd:Q390711 wd:Q395340 wd:Q401199 wd:Q401469 wd:Q401781 wd:Q401885 wd:Q401998 wd:Q425658 wd:Q446415 wd:Q461221 wd:Q462737 wd:Q468297 wd:Q468418 wd:Q469247 wd:Q469782 wd:Q517599 wd:Q524109 wd:Q526382 wd:Q542578 wd:Q554853 wd:Q576586 wd:Q586303 wd:Q587928 wd:Q597625 wd:Q608027 wd:Q616635 wd:Q656838 wd:Q657933 wd:Q667457 wd:Q671731 wd:Q680301 wd:Q693103 wd:Q694908 wd:Q719346 wd:Q728018 wd:Q738266 wd:Q787437 wd:Q924251 wd:Q944433 wd:Q964125 wd:Q982729 wd:Q982765 wd:Q982899 wd:Q1016269 wd:Q1031846 wd:Q1053284 wd:Q1194484 wd:Q1250238 wd:Q1273825 wd:Q1335936 wd:Q1352851 wd:Q1362422 wd:Q1372236 wd:Q1385869 wd:Q1393020 wd:Q1395090 wd:Q1528137 wd:Q1528301 wd:Q1583802 wd:Q1584306 wd:Q1584321 wd:Q1745687 wd:Q1892066 wd:Q2282849 wd:Q2351863 wd:Q2376406 wd:Q2447460 wd:Q2462315 wd:Q2474371 wd:Q2517990 wd:Q2525540 wd:Q2530775 wd:Q2559066 wd:Q2667099 wd:Q2925576 wd:Q2933169 wd:Q3048167 wd:Q3064310 wd:Q3123742 wd:Q3123755 wd:Q3124772 wd:Q3131375 wd:Q3259971 wd:Q3267911 wd:Q3272599 wd:Q3277737 wd:Q3326512 wd:Q3337865 wd:Q3356428 wd:Q3434403 wd:Q3446906 wd:Q3496037 wd:Q3496776 wd:Q3500793 wd:Q3503732 wd:Q3574613 wd:Q3626505 wd:Q3986664 wd:Q4730588 wd:Q4808954 wd:Q4831964 wd:Q4998761 wd:Q5003637 wd:Q5255185 wd:Q5263293 wd:Q5372483 wd:Q5445619 wd:Q5687128 wd:Q5875297 wd:Q5964927 wd:Q5999082 wd:Q6002551 wd:Q6006823 wd:Q6029932 wd:Q6030798 wd:Q6042899 wd:Q6046472 wd:Q6053452 wd:Q6054146 wd:Q6057025 wd:Q6061949 wd:Q6063354 wd:Q6065706 wd:Q6075772 wd:Q6079141 wd:Q6081168 wd:Q6084948 wd:Q6090990 wd:Q6092714 wd:Q6093684 wd:Q6103039 wd:Q6355649 wd:Q6367507 wd:Q6586688 wd:Q7398816 wd:Q7809224 wd:Q8061960 wd:Q8080164 wd:Q8080212 wd:Q11862844 wd:Q14230114 wd:Q15078706 wd:Q16535532 wd:Q16841606 wd:Q17046863 wd:Q17540063 wd:Q18129444 wd:Q18169389 wd:Q19263820 wd:Q19668785 wd:Q20471921 wd:Q20474505 wd:Q21524665 wd:Q21580710 wd:Q23722902 wd:Q23921031 wd:Q26270598 wd:Q31189593 wd:Q31191868 wd:Q31206497 wd:Q53322410 wd:Q55439659 wd:Q56283552 wd:Q65307943 wd:Q65599731 wd:Q66817415 yerine getir.mjs en çok 400 kişilik bir öbek koyar.
# tur: dogum/olum (P569/P570: değer, hassasiyet, takvim, kerte, P1480 kaynak durumu), meslek (P106),
#      ulke (P27), etiket (tr/en/mul), aciklama (tr/en), trwiki (sayfa başlığı). Kaldırılmış (deprecated) deyimler alınmaz.
SELECT ?p ?tur ?s ?zaman ?hassasiyet ?takvim ?derece ?nitelik ?hedef ?dil ?metin ?enMetin WHERE {
  VALUES ?p { wd:Q60216 wd:Q67629 wd:Q67631 wd:Q67639 wd:Q174709 wd:Q179445 wd:Q187261 wd:Q195122 wd:Q236920 wd:Q255195 wd:Q263581 wd:Q271538 wd:Q271578 wd:Q273637 wd:Q283351 wd:Q283737 wd:Q307808 wd:Q317592 wd:Q326849 wd:Q327661 wd:Q328247 wd:Q338148 wd:Q343262 wd:Q343331 wd:Q343372 wd:Q344201 wd:Q344368 wd:Q349199 wd:Q353068 wd:Q366274 wd:Q367949 wd:Q378768 wd:Q388023 wd:Q390602 wd:Q390711 wd:Q395340 wd:Q401199 wd:Q401469 wd:Q401781 wd:Q401885 wd:Q401998 wd:Q425658 wd:Q446415 wd:Q461221 wd:Q462737 wd:Q468297 wd:Q468418 wd:Q469247 wd:Q469782 wd:Q517599 wd:Q524109 wd:Q526382 wd:Q542578 wd:Q554853 wd:Q576586 wd:Q586303 wd:Q587928 wd:Q597625 wd:Q608027 wd:Q616635 wd:Q656838 wd:Q657933 wd:Q667457 wd:Q671731 wd:Q680301 wd:Q693103 wd:Q694908 wd:Q719346 wd:Q728018 wd:Q738266 wd:Q787437 wd:Q924251 wd:Q944433 wd:Q964125 wd:Q982729 wd:Q982765 wd:Q982899 wd:Q1016269 wd:Q1031846 wd:Q1053284 wd:Q1194484 wd:Q1250238 wd:Q1273825 wd:Q1335936 wd:Q1352851 wd:Q1362422 wd:Q1372236 wd:Q1385869 wd:Q1393020 wd:Q1395090 wd:Q1528137 wd:Q1528301 wd:Q1583802 wd:Q1584306 wd:Q1584321 wd:Q1745687 wd:Q1892066 wd:Q2282849 wd:Q2351863 wd:Q2376406 wd:Q2447460 wd:Q2462315 wd:Q2474371 wd:Q2517990 wd:Q2525540 wd:Q2530775 wd:Q2559066 wd:Q2667099 wd:Q2925576 wd:Q2933169 wd:Q3048167 wd:Q3064310 wd:Q3123742 wd:Q3123755 wd:Q3124772 wd:Q3131375 wd:Q3259971 wd:Q3267911 wd:Q3272599 wd:Q3277737 wd:Q3326512 wd:Q3337865 wd:Q3356428 wd:Q3434403 wd:Q3446906 wd:Q3496037 wd:Q3496776 wd:Q3500793 wd:Q3503732 wd:Q3574613 wd:Q3626505 wd:Q3986664 wd:Q4730588 wd:Q4808954 wd:Q4831964 wd:Q4998761 wd:Q5003637 wd:Q5255185 wd:Q5263293 wd:Q5372483 wd:Q5445619 wd:Q5687128 wd:Q5875297 wd:Q5964927 wd:Q5999082 wd:Q6002551 wd:Q6006823 wd:Q6029932 wd:Q6030798 wd:Q6042899 wd:Q6046472 wd:Q6053452 wd:Q6054146 wd:Q6057025 wd:Q6061949 wd:Q6063354 wd:Q6065706 wd:Q6075772 wd:Q6079141 wd:Q6081168 wd:Q6084948 wd:Q6090990 wd:Q6092714 wd:Q6093684 wd:Q6103039 wd:Q6355649 wd:Q6367507 wd:Q6586688 wd:Q7398816 wd:Q7809224 wd:Q8061960 wd:Q8080164 wd:Q8080212 wd:Q11862844 wd:Q14230114 wd:Q15078706 wd:Q16535532 wd:Q16841606 wd:Q17046863 wd:Q17540063 wd:Q18129444 wd:Q18169389 wd:Q19263820 wd:Q19668785 wd:Q20471921 wd:Q20474505 wd:Q21524665 wd:Q21580710 wd:Q23722902 wd:Q23921031 wd:Q26270598 wd:Q31189593 wd:Q31191868 wd:Q31206497 wd:Q53322410 wd:Q55439659 wd:Q56283552 wd:Q65307943 wd:Q65599731 wd:Q66817415 }
  {
    ?p p:P569 ?s . ?s wikibase:rank ?derece ;
       psv:P569 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("dogum" AS ?tur)
  } UNION {
    ?p p:P570 ?s . ?s wikibase:rank ?derece ;
       psv:P570 [ wikibase:timeValue ?zaman ; wikibase:timePrecision ?hassasiyet ; wikibase:timeCalendarModel ?takvim ] .
    OPTIONAL { ?s pq:P1480 ?nitelik }
    BIND("olum" AS ?tur)
  } UNION {
    ?p p:P106 ?s . ?s ps:P106 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("meslek" AS ?tur)
  } UNION {
    ?p p:P27 ?s . ?s ps:P27 ?hedef ; wikibase:rank ?derece .
    OPTIONAL { ?hedef rdfs:label ?metin FILTER(LANG(?metin) = "tr") }
    OPTIONAL { ?hedef rdfs:label ?enMetin FILTER(LANG(?enMetin) = "en") }
    BIND("ulke" AS ?tur)
  } UNION {
    ?p rdfs:label ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en", "mul"))
    BIND("etiket" AS ?tur)
  } UNION {
    ?p schema:description ?metin . BIND(LANG(?metin) AS ?dil) FILTER(?dil IN ("tr", "en"))
    BIND("aciklama" AS ?tur)
  } UNION {
    ?a schema:about ?p ; schema:isPartOf <https://tr.wikipedia.org/> ; schema:name ?metin .
    BIND("trwiki" AS ?tur)
  }
  FILTER(!BOUND(?derece) || ?derece != wikibase:DeprecatedRank)
}
ORDER BY ?p ?tur ?s ?hedef ?nitelik ?dil ?metin ?enMetin
